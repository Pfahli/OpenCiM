<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">OpenCiM</string>
    <string name="shortcut_files">Game files</string>
    <string name="shortcut_files_long">Get or update Cities in Motion</string>
    <color name="bg">#15100C</color>

    <!-- the setup screen: the Windows setup's colours (src/setup/setup_main.cpp) -->
    <style name="Setup" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">#D9772B</item>
        <item name="android:colorControlActivated">#D9772B</item>
    </style>

    <!-- the game: full screen, also beside a camera cut-out -->
    <style name="Game" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
