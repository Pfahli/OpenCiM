// ReGS extension of the editor toolbar (metro/ui/toolbar/toolbar.script, used as installed; see VM::extendSource),
// owner's request 2026-11-07: the building list gets a category "Vehicles" with every player vehicle (buses, trams,
// metro trains, boats, helicopters, DLC ones included) and every AI vehicle (cars, trucks, trains, ships, aircraft)
// of the loaded location, to place as scenery: the vehicle's own template stands on the map as a plain object.
//@rename openBuildingMenu regsBaseOpenBuildingMenu

//@base

function openBuildingMenu() {
  regsBaseOpenBuildingMenu();
  $regsFile = "regs/strings/"+MAIN.$language+".strings";
  if (!file_exists($regsFile)) $regsFile = "regs/strings/en_US.strings";
  $regsS = load "/"+$regsFile;
  MAIN.$strings.$category_vehicles = $regsS.$regs_category_vehicles;
  delete $regsS;
  $regsSeen = map [];
  foreach (MAIN.$level.$playerVehicles) {
    $regsName = current[0];
    if (!(defined $regsSeen[$regsName]) && $grid.getGridObject($regsName)) {
      $regsSeen[$regsName] = true;
      $list.addItem("vehicles", $regsName, macro($regsName) :: selectObject($0));
    }
  }
  foreach (MAIN.$level.$regsAIVehicles : []) {
    $regsName = current;
    if (!(defined $regsSeen[$regsName]) && $grid.getGridObject($regsName)) {
      $regsSeen[$regsName] = true;
      $list.addItem("vehicles", $regsName, macro($regsName) :: selectObject($0));
    }
  }
}

// the brush shapes (owner's request 2026-11-14): a second column of buttons beside the brush sizes, with symbols
// (regs/ui/toolbar/brush-*.dds, drawn by tools/make-brush-icons.ps1): circle, square, diamond and line (regsBrushShape,
// engine/tool_terrain.cpp). The size bar grows to two columns, so the buttons show, hide and go with it.
$regsShapeFile = "regs/strings/"+MAIN.$language+".strings";
if (!file_exists($regsShapeFile)) $regsShapeFile = "regs/strings/en_US.strings";
$regsShapeS = load "/"+$regsShapeFile;
$sizebar.width = 100;
$regsShapeArea = new_control($sizebar);
$regsShapeArea.setRect(50, 0, 50, 190);
$regsShapeArea.visible = true;
$regsShapeButtons = [];
$regsShapeNames = ["circle", "square", "diamond", "line"];
$regsShapeHints = [$regsShapeS.$regs_brush_circle, $regsShapeS.$regs_brush_square, $regsShapeS.$regs_brush_diamond, $regsShapeS.$regs_brush_line];
delete $regsShapeS;
for ($regsI = 0; $regsI < 4; ++$regsI) {
  $regsIcon = "/regs/ui/toolbar/brush-" + $regsShapeNames[$regsI];
  $regsB = MAIN.$ui.createChoiceButton($regsShapeArea, $regsShapeArea, 0, $regsI * 45 + 5, 40, 40, "", macro($regsI) :: regsBrushShape($0),
    $regsIcon + ".dds", $regsIcon + "_se.dds", $regsIcon + "_ho.dds");
  MAIN.$ui.setTooltip($regsB, $regsShapeHints[$regsI], 1, 0);
  $regsShapeButtons[] = $regsB;
}
MAIN.$ui.selectChoiceButton($regsShapeButtons[regsBrushShape()], $regsShapeArea);
