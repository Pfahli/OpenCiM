// ReGS extension of metro/ui/loading/loading.script (used as installed; see VM::extendSource): when every game script
// has loaded, the port builds the map's cache (materials, textures, night-light masks, grid items) while the loading
// screen still shows, before the Spielen button; otherwise the first frame after the button stayed black for seconds.

//@base

event this.enter::["Completed"]() {
  regsPrewarmGrid();
}
