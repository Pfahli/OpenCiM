// ReGS extension of the main menu (metro/ui/menus/mainmenu.script, used as installed; see VM::extendSource).
// * The original plays the menu music at volume 1.0 whatever the music settings (docs/audio/README.md §10). With the
//   port's optional fix $regsMenuMusicFollowsMusicVolume (Audio page, off by default as the original) it follows the
//   in-game music's settings: $musicVolume, silent when music is off. The Audio page's OK applies a change at once.
// * The port's title "OPENCiM" above the CITIES in MOTION logo (the port's own art, regs/ui/opencim-title.dds, made by
//   tools/make-opencim-logo.ps1), and the version, build and a short note in the bottom right corner.
// * The map editor's "load map" list also shows the original game's maps (Documents\Cities In Motion\maps, read only)
//   with a note; main.script's startEditor (extension) copies the chosen one into the OpenCiM folder.
// * Content packages (main.script extension): choosing a map in the editor's load list or starting a sandbox game on
//   a map whose packages are not all installed asks first ("Open anyway" or cancel).
//@rename showDialog regsBaseShowDialog
//@rename buttonClick regsBaseButtonClick
//@base

if (MAIN.$settings.$regsMenuMusicFollowsMusicVolume : false) {
  $menuMusic.volume = (MAIN.$settings.$music : true) ? (MAIN.$settings.$musicVolume : 0.3) : 0.0;
}

if (file_exists("regs/strings/"+MAIN.$language+".strings")) {
  $regsStrings = load "/regs/strings/"+MAIN.$language+".strings";
} else {
  $regsStrings = load "/regs/strings/en_US.strings";
}

// above the logo: the logo's art spans its top half in the 256 x 128 image, so the title sits just over it
with ($regsTitle = new_control($menuArea)) {
  .setRect(int($menuArea.width*0.5)-128, int($buttonArea.top*0.5) - 112, 256, 64);
  .setImage("/regs/ui/opencim-title.dds");
  .visible = true;
  .canActivate = false;
  .clickThrough = true;
}

function regsCornerLine($y, $text, $color) {
  with ($line = new_control($background)) {
    .setRect($background.width - 520, $background.height - $y, 510, 18);
    .textAlign = ALIGN_RIGHT | ALIGN_MIDDLE;
    MAIN.$ui.setTextFont($line, $color);
    .text = $text;
    .visible = true;
    .canActivate = false;
    .clickThrough = true;
  }
  return $line;
}

$regsVersionLine = regsCornerLine(62, expandPattern($regsStrings.$regs_menu_version, REGS_VERSION), 0xFFE0E0E0);
$regsBuildLine = regsCornerLine(44, expandPattern($regsStrings.$regs_menu_build, REGS_BUILD, REGS_COMMIT, REGS_BUILD_DATE), 0xB0C8C8C8);
$regsInfoLine = regsCornerLine(26, $regsStrings.$regs_menu_info, 0xB0C8C8C8);

// main.script's LoadMapMenu passes the OpenCiM maps (key = file name); the original's maps without a copy in OpenCiM
// follow them, keyed "~<name>|regs-cim:<file>" so they sort last and the dialog returns the part after the bar
function showDialog($text, $inputText = false, $default = "", $items = null) {
  if (!$inputText && $items != null && $text == $strings.$menu_loadMap_dialog) {
    foreach (regsOriginalMaps()) {
      $items["~"+current+"|regs-cim:"+current] = changeFileExt(current, "")+" "+$regsStrings.$regs_fromOriginal_note;
    }
  }
  regsBaseShowDialog($text, $inputText, $default, $items);
}

// the map an OK opens: the editor's load list hands over "<name>.grid", the sandbox page's start button its map
function regsPickedMap($text, $actionName) {
  if ($actionName != "ok") return "";
  if (#$text > 5 && findstr($text, "regs-cim:") < 0 && substr($text, #$text - 5) == ".grid") return "userdata/maps/"+$text;
  if ($text == $strings.$menu_sandboxStart_button) {
    $sub = MAIN.$main.$submenu : null;
    if ($sub) return $sub.$selectedMap : "";
  }
  return "";
}

function buttonClick($text, $actionName) {
  $map = regsPickedMap($text, $actionName);
  if ($map == "" || #MAIN.$main.regsMissingPackages($map) == 0) {
    regsBaseButtonClick($text, $actionName);
    return;
  }
  $regsPendingText = $text;
  $regsPendingAction = $actionName;
  $regsPendingMap = $map;
  thread :: {  // the dialog waits for the player; the load list goes back when cancelled, the sandbox page stays
    if (MAIN.$main.regsConfirmPackages($regsPendingMap)) regsBaseButtonClick($regsPendingText, $regsPendingAction);
    else if ($regsPendingText != $strings.$menu_sandboxStart_button) regsBaseButtonClick($regsPendingText, "cancel");
  };
}
