// ReGS extension of the game's graphics page (metro/ui/menus/graphics.script, used as installed). The part before
// //@base runs before the original page, the rest after it, in the same script (see VM::extendSource). It lays the
// page out in three columns (display, quality, effects and style) with drop-down lists for resolution, frequency and
// the presets, and adds the port's options (stored as regs* settings, or fpsLimit, which the game reads but never
// offered here), more steps for shadows and antialiasing, the style effects, the frame-rate readout and the "Image
// quality" button above OK and Cancel (regs/ui/quality.script).
// New options: a row in a column, a column in $regsPresets if it is a quality option, and a line in save().
//@rename save regsBaseSave

if (file_exists("regs/strings/"+MAIN.$language+".strings")) {
  $regs = load "/regs/strings/"+MAIN.$language+".strings";
} else {
  $regs = load "/regs/strings/en_US.strings";
}
// the original page indexes these with the stored values ($shadows, $antialiasing / 2): cover the extended ones
MAIN.$strings.$menu_shadows_values = $regs.$regs_shadows_byValue;
MAIN.$strings.$menu_antialiasing_values = $regs.$regs_antialiasing_byHalf;

//@base

// ---- after the original page ----

$shadowValues = [0, 1, 2, 4, 8];                // $settings.$shadows; the map is $shadows × 1024 texels square
$antialiasValues = [0, 2, 4, 8];                // MSAA samples
$fpsValues = [0.0, 30.0, 60.0, 90.0, 120.0, 144.0];

function regsStepOf($values, $value) {
  $step = 0;
  for ($i = 0; $i < #$values; ++$i) {
    if ($values[$i] <= $value) $step = $i;
  }
  return $step;
}

$regsShadowStep = regsStepOf($shadowValues, $settings.$shadows : 0);
$regsAntialiasStep = regsStepOf($antialiasValues, $settings.$antialiasing : 0);
$shadows = $shadowValues[$regsShadowStep];
$antialiasing = $antialiasValues[$regsAntialiasStep] / 2;
$viewDistance = $settings.$regsViewDistance : 1.0;
$detailDistance = $settings.$regsDetailDistance : 1.0;
$fpsLimit = regsStepOf($fpsValues, $settings.$fpsLimit : 0.0);
$colorStyle = int($settings.$regsColorStyle : 0);
$lensBlur = int($settings.$regsLensBlur : 0);
$vignette = int($settings.$regsVignette : 0);
$filmGrain = int($settings.$regsFilmGrain : 0);

// ---- the layout (owner's request 2026-11-18): three columns with headings, like the Image quality page.
// Display: resolution and frequency (drop-down lists), fullscreen, vsync, frame-rate limit, UI scale, cursor and
// readouts. Quality: the preset (a drop-down list with "Custom"), shadows, antialiasing, anisotropy, distances.
// Effects and style: bloom and saturation, colour style (with its preview), lens blur, vignette, film grain, day
// and night; sharper textures sit under the quality settings. The original page's own
// controls are moved (its variables, setters and save() stay in charge); its resolution and frequency lists are hidden
// behind the drop-down lists, which call its selectResolution / selectFrequency.
$regsColX = [30, 355, 680];
$regsColW = 290;

function regsLabel($x, $y, $text) {
  with ($label = new_control($box.$content)) {
    .setRect($x, $y, $regsColW, 18);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .text = $text;
    .visible = true;
    .canActivate = false;
  }
  return $label;
}

function regsRule($x, $y, $w, $h) {
  with ($regsRuleCtl = new_control($box.$content)) {
    .setRect($x, $y, $w, $h);
    .background = 0x40FFFFFF;
    .visible = true;
    .canActivate = false;
  }
}

function regsHeading($x, $y, $text) {
  with ($regsHeadingCtl = new_control($box.$content)) {  // the title font first, then the text (as on Image quality)
    .setRect($x, $y, $regsColW, 18);
    MAIN.$ui.setTitleFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .text = $text;
    .visible = true;
    .canActivate = false;
  }
  regsRule($x, $y + 22, $regsColW, 1);
}

function regsSlider($x, $y, $steps, $step) {
  return MAIN.$ui.createSlider($box.$content, $step * ($steps - 0.01) / ($steps - 1), 0.0, $steps - 0.01, $x, $y, 215, 27);
}

// a checkbox row: the original's button and label at a new place
function regsCheckRow($button, $item, $x, $y) {
  $button.setRect($x, $y + 1, 16, 16);
  $item.setRect($x + 20, $y, $regsColW - 20, 18);
}

// a slider row: its label (with the value) over the slider
function regsSliderRow($item, $slider, $x, $y) {
  $item.setRect($x, $y, $regsColW, 18);
  $slider.setRect($x, $y + 18, 215, 27);
}

// a drop-down list in the look of the Image quality page: a dark field, the game's createDropList, its small arrow
function regsDropDown($x, $y, $w) {
  with ($regsDdField = new_control($box.$content)) {
    .setRect($x, $y - 3, $w, 24);
    .background = 0xFF0E0B09;
    .visible = true;
    .canActivate = false;
  }
  with ($regsDd = MAIN.$ui.createDropList($box.$content, $x, $y - 3, $w, 24)) {
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .$list.background = 0xFF1A1512;
    .$items = [];
  }
  with ($regsDdArrow = new_control($regsDd)) {
    .setRect($w - 21, 4, 16, 16);
    .setImage("/metro/ui/down-small.dds");
    .visible = true;
    .canActivate = false;
  }
  return $regsDd;
}

function regsDropItem($list, $text, $action) {
  with ($regsDdItem = MAIN.$ui.addDropListItem($list, "  " + $text, $action)) {
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
  }
  $list.$items[] = $regsDdItem;
  return $regsDdItem;
}

regsRule($regsColX[1] - 15, 58, 1, 430);
regsRule($regsColX[2] - 15, 58, 1, 430);

// ---- display ----
$x = $regsColX[0];
regsHeading($x, 58, $regs.$regs_g_display);

$resolutionArea.visible = false;  // the original lists stay as the place selectResolution fills
$frequencyArea.visible = false;
$resolutionItem.setRect($x, 96, 100, 18);
$regsResolutionList = regsDropDown($x + 105, 96, 185);
$regsPrevMode = null;
foreach (display_modes()) {
  if (.width < 1024 || .height < 720 || .bits < 32) continue;
  if ($regsPrevMode) if ($regsPrevMode.width == .width && $regsPrevMode.height == .height && $regsPrevMode.bits == .bits) continue;
  $regsPrevMode = current;
  $regsModeItem = regsDropItem($regsResolutionList, escapePattern(expandPattern($strings.$menu_resolution_pattern, .width, .height, .bits)), macro(current) :: regsPickResolution($0));
  if ($screenwidth == .width && $screenheight == .height && $screencolors == .bits) MAIN.$ui.selectDropListItem($regsModeItem);
}

$frequencyItem.setRect($x, 128, 100, 18);
$regsFrequencyList = regsDropDown($x + 105, 128, 185);
$regsFrequencyList.visible = PLATFORM == "windows";
// the frequencies of the chosen resolution (the original keeps its own list in step through selectResolution)
function regsFillFrequencies() {
  $regsFrequencyList.$list.clear();
  $regsFrequencyList.$items = [];
  $regsFrequencyList.$selected = null;
  foreach (display_modes()) {
    if (.width != $screenwidth || .height != $screenheight || .bits != $screencolors) continue;
    $regsFreqItem = regsDropItem($regsFrequencyList, escapePattern(expandPattern($strings.$menu_frequency_pattern, .freq)), macro(current.freq) :: selectFrequency($0));
    if ($frequency == .freq) MAIN.$ui.selectDropListItem($regsFreqItem);
  }
}
function regsPickResolution($mode) {
  selectResolution($mode);
  regsFillFrequencies();
}
regsFillFrequencies();

regsCheckRow($fullscreenButton, $fullscreenItem, $x, 160);
regsCheckRow($vsyncButton, $vsyncItem, $x, 186);

with ($regsFpsItem = regsLabel($x, 214, $regs.$regs_fpsLimit_item)) {
  .setArg(0, macro :: $regs.$regs_fpsLimit_values[$fpsLimit]);
}
$fpsLimitSlider = regsSlider($x, 232, #$fpsValues, $fpsLimit);
$fpsLimitSlider.$action = macro :: regsSetFpsLimit();
function regsSetFpsLimit() {
  $fpsLimit = int($fpsLimitSlider.$value);
}

// UI scale: $regsUiScale 1.0 / 1.5 / 2.0, read by the engine when the window opens or changes (Display::chooseUiScale,
// docs/ui/scaling.md). Unset: 2x on windows taller than 1800 px, else 1x (the page shows the scale in use); the
// setting is written only when the player picks another value.
$uiScaleValues = [1.0, 1.5, 2.0];
$regsUiScaleShown = regsStepOf($uiScaleValues, $settings.$regsUiScale : MAIN.$window.regsUiScale());
$uiScale = $regsUiScaleShown;
with (regsLabel($x, 270, $regs.$regs_uiScale_item)) .setRect($x, 270, 100, 18);
$regsUiScaleButtons = [];
for ($i = 0; $i < #$uiScaleValues; ++$i) {
  $regsUiScaleButtons[$i] = MAIN.$ui.createChoiceButton($box.$content, "regsUiScale", $x + 105 + $i * 62, 270, 60, 18, $regs.$regs_uiScale_values[$i], macro($i) :: regsSetUiScale($0));
  MAIN.$ui.setTooltip($regsUiScaleButtons[$i], $regs.$regs_uiScale_hint, 0, -1);
}
function regsSetUiScale($index) {
  $uiScale = $index;
  MAIN.$ui.selectChoiceButton($regsUiScaleButtons[$uiScale], "regsUiScale");
}
regsSetUiScale($uiScale);

regsCheckRow($systemCursorButton, $systemCursorItem, $x, 304);
regsCheckRow($framerateButton, $framerateItem, $x, 330);
// the port's frame-rate readout (drawn by the engine, display.cpp)
$showFps = $settings.$regsShowFps : false;
$regsShowFpsButton = MAIN.$ui.createChoiceButton($box.$content, "self", $x, 357, 16, 16, "", macro :: regsSetShowFps(!$showFps), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
regsLabel($x + 20, 356, $regs.$regs_showFps_item);
function regsSetShowFps($value) {
  $showFps = $value;
  MAIN.$ui.selectChoiceButton($showFps ? $regsShowFpsButton : null, $regsShowFpsButton);
}
regsSetShowFps($showFps);
// the game's own $stopWithoutFocus (system.script, no menu in the original): the game pauses while its window is not
// in focus (default) or runs on behind other windows; applied live on OK (engine/input.cpp, owner's request 2026-11-24)
$pauseUnfocused = $settings.$stopWithoutFocus : true;
$regsPauseUnfocusedButton = MAIN.$ui.createChoiceButton($box.$content, "self", $regsColX[0], 383, 16, 16, "", macro :: regsSetPauseUnfocused(!$pauseUnfocused), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
regsLabel($regsColX[0] + 20, 382, $regs.$regs_pauseUnfocused_item);
function regsSetPauseUnfocused($value) {
  $pauseUnfocused = $value;
  MAIN.$ui.selectChoiceButton($pauseUnfocused ? $regsPauseUnfocusedButton : null, $regsPauseUnfocusedButton);
}
regsSetPauseUnfocused($pauseUnfocused);

// ---- quality ----
$x = $regsColX[1];
regsHeading($x, 58, $regs.$regs_g_quality);

// presets: shadows step, antialiasing step, anisotropy step, HDR lighting, view distance, detail distance.
// "Original" is the game's own defaults (metro/defaults/settings.script). The list's last entry, "Custom", is what it
// shows whenever the values match no preset; picking it changes nothing.
$regsPresets = [
  [1, 0, 1, false, 1.0, 1.0],   // low
  [2, 1, 2, true, 1.0, 1.0],    // medium
  [2, 2, 3, true, 1.0, 1.0],    // original
  [3, 2, 4, true, 1.5, 1.5],    // high
  [4, 3, 4, true, 2.5, 2.0]     // ultra
];
with (regsLabel($x, 96, $regs.$regs_preset_label)) .setRect($x, 96, 125, 18);
$regsPresetList = regsDropDown($x + 130, 96, 160);
for ($i = 0; $i < #$regsPresets; ++$i) regsDropItem($regsPresetList, $regs.$regs_preset_values[$i], macro($i) :: regsApplyPreset($0));
regsDropItem($regsPresetList, $regs.$regs_preset_custom, macro :: regsUpdatePreset());

// the original sliders, with more steps for shadows and antialiasing; every change re-checks the preset
regsSliderRow($shadowsItem, $shadowsSlider, $x, 132);
$shadowsSlider.$max = 4.99;
$shadowsSlider.$action = regsSetShadows;
$shadowsItem.setArg(0, macro :: $regs.$regs_shadows_values[$regsShadowStep]);
MAIN.$ui.setSliderPos($shadowsSlider, $regsShadowStep * 4.99 / 4.0);
function regsSetShadows() {
  $regsShadowStep = int($shadowsSlider.$value);
  $shadows = $shadowValues[$regsShadowStep];
  regsUpdatePreset();
}

regsSliderRow($antialiasItem, $antialiasSlider, $x, 184);
$antialiasSlider.$action = regsSetAntialias;
$antialiasItem.setArg(0, macro :: $regs.$regs_antialiasing_values[$regsAntialiasStep]);
MAIN.$ui.setSliderPos($antialiasSlider, $regsAntialiasStep * 3.99 / 3.0);
function regsSetAntialias() {
  $regsAntialiasStep = int($antialiasSlider.$value);
  $antialiasing = $antialiasValues[$regsAntialiasStep] / 2;
  regsUpdatePreset();
}

regsSliderRow($anisotropyItem, $anisotropySlider, $x, 236);
MAIN.$ui.setSliderPos($anisotropySlider, $anisotropy * 4.99 / 4.0);
$anisotropySlider.$action = regsSetAnisotropy;
function regsSetAnisotropy() {
  setAnisotropy();
  regsUpdatePreset();
}

with (regsLabel($x, 288, $regs.$regs_viewDistance_item)) {
  .setArg(0, macro :: int($viewDistance * 100.0 + 0.5));
}
$viewDistanceSlider = MAIN.$ui.createSlider($box.$content, $viewDistance, 1.0, 3.0, $x, 306, 215, 27);
$viewDistanceSlider.$action = regsSetViewDistance;
function regsSetViewDistance() {
  $viewDistance = int($viewDistanceSlider.$value * 20.0 + 0.5) / 20.0;  // 5 % steps
  regsUpdatePreset();
}

with (regsLabel($x, 340, $regs.$regs_detailDistance_item)) {
  .setArg(0, macro :: int($detailDistance * 100.0 + 0.5));
}
$detailDistanceSlider = MAIN.$ui.createSlider($box.$content, $detailDistance, 1.0, 3.0, $x, 358, 215, 27);
$detailDistanceSlider.$action = regsSetDetailDistance;
function regsSetDetailDistance() {
  $detailDistance = int($detailDistanceSlider.$value * 20.0 + 0.5) / 20.0;
  regsUpdatePreset();
}

// sharper textures (port option, docs/renderer/texture-upscaling.md): textures upscaled 2x on this PC from the
// player's own install, cached in OpenCiM	exture-cache; switched live on OK (engine/display.cpp). Missing ones are
// made in the background; the line under it shows how far that is
$textureUpscale = $settings.$regsTextureUpscale : false;
$regsTextureUpscaleButton = MAIN.$ui.createChoiceButton($box.$content, "self", $regsColX[1], 404, 16, 16, "", macro :: regsSetTextureUpscale(!$textureUpscale), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
MAIN.$ui.setTooltip(regsLabel($regsColX[1] + 20, 403, $regs.$regs_textureUpscale_item), $regs.$regs_textureUpscale_hint, 0, -1);
function regsTextureUpscaleStatus() {
  $p = MAIN.$window.regsTextureUpscaleProgress();
  if ($p < 0) return "";
  return $regs.$regs_textureUpscale_progress + " " + string($p) + " %";
}
with (regsLabel($regsColX[1] + 20, 424, "%0")) {
  .setArg(0, macro :: regsTextureUpscaleStatus());
}
// ---- effects and style ----
$x = $regsColX[2];
regsHeading($x, 58, $regs.$regs_g_effects);

regsCheckRow($lightingButton, $lightingItem, $x, 96);
$lightingItem.text = $regs.$regs_bloom_item;  // the game calls it "HDR lighting"; it is the bloom (glow), not HDR output
$lightingButton.$action = macro :: regsSetHDR(!$hdrLighting);
function regsSetHDR($value) {
  setHDRlighting($value);
  regsUpdatePreset();
}
regsSliderRow($saturationItem, $saturationSlider, $x, 122);
MAIN.$ui.setSliderPos($saturationSlider, $saturation);

// style (not part of the presets): colour grade and lens blur after the scene, each a drop-down list; under the
// colour style a preview: the game view (or, in the main menu, the Vienna map picture) graded with the chosen style
// by the engine (regsStylePreview, engine/effects.cpp)
with (regsLabel($x, 178, $regs.$regs_colorStyle_label)) .setRect($x, 178, 100, 18);
$regsColorStyleList = regsDropDown($x + 105, 178, 185);
for ($i = 0; $i < #$regs.$regs_colorStyle_values; ++$i) {
  $regsStyleItem = regsDropItem($regsColorStyleList, $regs.$regs_colorStyle_values[$i], macro($i) :: regsSetColorStyle($0));
  if ($i == $colorStyle) MAIN.$ui.selectDropListItem($regsStyleItem);
}
with ($regsStylePreview = new_control($box.$content)) {
  .setRect($x, 210, 256, 144);
  .setBorder(0xFF5A5048, 1);
  .setImage(regsStylePreview($colorStyle, $vignette, $filmGrain, true));  // true: the game view is taken again
  .visible = true;
  .canActivate = false;
}
function regsSetColorStyle($value) {
  $colorStyle = $value;
  regsStylePreview($colorStyle, $vignette, $filmGrain);
}

with (regsLabel($x, 372, $regs.$regs_lensBlur_label)) .setRect($x, 372, 100, 18);
$regsLensBlurList = regsDropDown($x + 105, 372, 185);
for ($i = 0; $i < #$regs.$regs_lensBlur_values; ++$i) {
  $regsBlurItem = regsDropItem($regsLensBlurList, $regs.$regs_lensBlur_values[$i], macro($i) :: regsSetLensBlur($0));
  if ($i == $lensBlur) MAIN.$ui.selectDropListItem($regsBlurItem);
}
function regsSetLensBlur($value) {
  $lensBlur = $value;
}

// vignette and film grain: off, light, strong (in the preview too)
with (regsLabel($x, 404, $regs.$regs_vignette_label)) .setRect($x, 404, 100, 18);
$regsVignetteList = regsDropDown($x + 105, 404, 185);
for ($i = 0; $i < #$regs.$regs_amount_values; ++$i) {
  $regsVignetteItem = regsDropItem($regsVignetteList, $regs.$regs_amount_values[$i], macro($i) :: regsSetVignette($0));
  if ($i == $vignette) MAIN.$ui.selectDropListItem($regsVignetteItem);
}
function regsSetVignette($value) {
  $vignette = $value;
  regsStylePreview($colorStyle, $vignette, $filmGrain);
}
with (regsLabel($x, 436, $regs.$regs_filmGrain_label)) .setRect($x, 436, 100, 18);
$regsGrainList = regsDropDown($x + 105, 436, 185);
for ($i = 0; $i < #$regs.$regs_amount_values; ++$i) {
  $regsGrainItem = regsDropItem($regsGrainList, $regs.$regs_amount_values[$i], macro($i) :: regsSetFilmGrain($0));
  if ($i == $filmGrain) MAIN.$ui.selectDropListItem($regsGrainItem);
}
function regsSetFilmGrain($value) {
  $filmGrain = $value;
  regsStylePreview($colorStyle, $vignette, $filmGrain);
}

// day and night (port option; the original keeps each location's fixed time of day): the cycle length in minutes
// of normal game speed is $regsDayLength (settings.script only, default 12)
$dayNight = $settings.$regsDayNight : true;  // on unless the player switched it off
$regsDayNightButton = MAIN.$ui.createChoiceButton($box.$content, "self", $x, 469, 16, 16, "", macro :: regsSetDayNight(!$dayNight), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
regsLabel($x + 20, 468, $regs.$regs_dayNight_item);
function regsSetDayNight($value) {
  $dayNight = $value;
  MAIN.$ui.selectChoiceButton($dayNight ? $regsDayNightButton : null, $regsDayNightButton);
}
regsSetDayNight($dayNight);

function regsSetTextureUpscale($value) {
  $textureUpscale = $value;
  MAIN.$ui.selectChoiceButton($textureUpscale ? $regsTextureUpscaleButton : null, $regsTextureUpscaleButton);
}
regsSetTextureUpscale($textureUpscale);

// ---- presets ----

function regsCurrentPreset() {
  for ($i = 0; $i < #$regsPresets; ++$i) {
    $p = $regsPresets[$i];
    if ($p[0] == $regsShadowStep && $p[1] == $regsAntialiasStep && $p[2] == $anisotropy && $p[3] == $hdrLighting && abs($p[4] - $viewDistance) < 0.01 && abs($p[5] - $detailDistance) < 0.01) return $i;
  }
  return -1;
}

// the list shows the matching preset, or "Custom" once the values match none
function regsUpdatePreset() {
  $regsPresetIndex = regsCurrentPreset();
  MAIN.$ui.selectDropListItem($regsPresetList.$items[$regsPresetIndex >= 0 ? $regsPresetIndex : #$regsPresets]);
}

function regsApplyPreset($index) {
  $p = $regsPresets[$index];
  $regsShadowStep = $p[0];
  $shadows = $shadowValues[$regsShadowStep];
  $regsAntialiasStep = $p[1];
  $antialiasing = $antialiasValues[$regsAntialiasStep] / 2;
  $anisotropy = $p[2];
  setHDRlighting($p[3]);
  $viewDistance = $p[4];
  $detailDistance = $p[5];
  MAIN.$ui.setSliderPos($shadowsSlider, $regsShadowStep * 4.99 / 4.0);
  MAIN.$ui.setSliderPos($antialiasSlider, $regsAntialiasStep * 3.99 / 3.0);
  MAIN.$ui.setSliderPos($anisotropySlider, $anisotropy * 4.99 / 4.0);
  MAIN.$ui.setSliderPos($viewDistanceSlider, $viewDistance);
  MAIN.$ui.setSliderPos($detailDistanceSlider, $detailDistance);
  $anisotropyItem.setArg(0, $strings.$menu_anisotropy_values[$anisotropy]);
  regsUpdatePreset();
}
regsUpdatePreset();

// the original save() (renamed regsBaseSave) stores its options, then the port's. The original asks for a restart
// ($requireRestart: the "restart needed" notice) for every rendering and display option; the port applies them at
// once: antialiasing and anisotropic filtering follow the settings in the engine (Display::syncRenderSettings),
// shadows, HDR lighting and saturation are made again by the game's engine.script (regsApplyEffects, its extension)
function save() {
  $regsOldDisplay = [$settings.$fullscreen : true, $settings.$screenwidth : 1024, $settings.$screenheight : 768, $settings.$screencolors : 32, $settings.$frequency : 60];
  regsBaseSave();
  $requireRestart = false;
  if (MAIN.$scene : false) if (defined MAIN.$regsEngine) MAIN.$regsEngine.regsApplyEffects();
  $settings.$regsViewDistance = $viewDistance;
  $settings.$regsDetailDistance = $detailDistance;
  $settings.$fpsLimit = $fpsValues[$fpsLimit];
  MAIN.fpsLimit = $settings.$fpsLimit;
  $settings.$regsColorStyle = $colorStyle;
  $settings.$regsLensBlur = $lensBlur;
  $settings.$regsVignette = $vignette;
  $settings.$regsFilmGrain = $filmGrain;
  $settings.$regsShowFps = $showFps;   // the engine reads it every frame: shown or hidden at once
  $settings.$regsDayNight = $dayNight; // read every frame too (engine/sky.cpp)
  $settings.$regsTextureUpscale = $textureUpscale; // read every frame (engine/display.cpp)
  $settings.$stopWithoutFocus = $pauseUnfocused;  // read at each focus change (engine/input.cpp)
  $settings.exportVariables("regsViewDistance", "regsDetailDistance", "fpsLimit", "regsColorStyle", "regsLensBlur", "regsVignette", "regsFilmGrain", "regsShowFps", "regsDayNight", "regsTextureUpscale", "stopWithoutFocus");
  $regsNewScale = $uiScale != $regsUiScaleShown;
  if ($regsNewScale) {
    $settings.$regsUiScale = $uiScaleValues[$uiScale];
    $settings.exportVariables("regsUiScale");
  }
  // fullscreen, resolution and UI scale: the engine resizes the window (fullscreen is borderless over the monitor, so
  // frequency and colour depth change nothing). While the scripts' window size stays the same the GUI stays as it is;
  // with a new size (result 2) the engine has laid the GUI out again, and main.script loads the open menu again and
  // comes back to this page (HUD panels whose layout follows the size in other ways re-place themselves: the
  // levelbar, moneybar, petitionbar and linepanel extensions)
  if ($regsNewScale || $regsOldDisplay[0] != $fullscreen || $regsOldDisplay[1] != $screenwidth || $regsOldDisplay[2] != $screenheight) {
    if (MAIN.$window.regsApplyDisplay($fullscreen, $screenwidth, $screenheight, true) == 2) MAIN.$main.regsRelayoutMenus();
  }
}

// ---- "Advanced settings" (the port's image options page, regs/ui/quality.script) on the left above OK,
// opened over this one
with ($regsQualityButton = MAIN.$ui.createButton($box.$content, 0, 0, 322, 32, $regs.$regs_quality_button, macro :: MAIN.$main.regsOpenQualityPage($box), "/metro/ui/menus/pause-menu-button.dds", "/metro/ui/menus/pause-menu-button.dds", "/metro/ui/menus/pause-menu-button_ho.dds")) {
  .setCropRect(96.0 / 512.0, 0.0, 322.0 / 512.0, 1.0);
  .textAlign = ALIGN_MIDDLE | ALIGN_CENTER;
  MAIN.$ui.setTitleFont(current);
  .setRect($okButton.left, $okButton.top - .height - 10, .width, .height);  // left, over OK
}
