// ReGS extension of the sandbox setup page (metro/ui/menus/sandbox.script, used as installed). The part before
// //@base runs before the original page, the rest after it, in the same script (see VM::extendSource). It adds the
// port's traffic and population density for the new game: main.script's loadSandboxScenario (extension) copies them
// into the campaign, campaign.script's saveCampaign (extension) keeps them in the save, and environment.script
// (extension) hands them to the simulation before the map loads.
// It also lists the original game's maps (Documents\Cities In Motion\maps, read only; engine/user_folders.h) that
// have no copy in the OpenCiM folder, after the OpenCiM maps and with a note; main.script's loadSandboxScenario copies
// the chosen one into OpenCiM before the game starts.

if (file_exists("regs/strings/"+MAIN.$language+".strings")) {
  $regs = load "/regs/strings/"+MAIN.$language+".strings";
} else {
  $regs = load "/regs/strings/en_US.strings";
}

//@rename selectMap regsBaseSelectMap
//@base

// ---- after the original page: the original game's maps at the end of the map list (as addMap, with the note) ----

// maps in folders below userdata/maps (the editor's folder system; autosaves left out), as "folder/name"
function regsAddFolderMaps($dir, $prefix) {
  foreach (list_dirs($dir)) {
    $sub = current;
    if (!($prefix == "" && $sub == "autosave")) {
      foreach (list_files($dir+"/"+$sub, ".grid")) {
        $file = $dir+"/"+$sub+"/"+current;
        $button = MAIN.$ui.createChoiceButton($itemsBox.$content, $itemsArea, 0, $y, $itemsBox.$content.width, 18, $prefix+$sub+"/"+changeFileExt(current, ""), macro($file) :: selectMap($0));
        $y += 18;
      }
      regsAddFolderMaps($dir+"/"+$sub, $prefix+$sub+"/");
    }
  }
}
regsAddFolderMaps("userdata/maps", "");

foreach (regsOriginalMaps()) {
  regsAddOriginalMap("regs-cim/maps/"+current);
}

function regsAddOriginalMap($filename) {
  $text = changeFileExt(extractFileName($filename), "")+" "+$regs.$regs_fromOriginal_note;
  $button = MAIN.$ui.createChoiceButton($itemsBox.$content, $itemsArea, 0, $y, $itemsBox.$content.width, 18, $text, macro($filename) :: selectMap($0));
  $y += 18;
}

// ---- two rows in the middle column, below the map size ----

$regsDensityValues = [0.5, 1.0, 2.0, 4.0];      // × the original game
$regsTrafficStep = 1;
$regsPopulationStep = 1;
$regsTrafficDensity = $regsDensityValues[$regsTrafficStep];
$regsPopulationDensity = $regsDensityValues[$regsPopulationStep];

function regsLabel($x, $y, $text) {
  with ($label = new_control($box.$content)) {
    .setRect($x, $y, 200, 18);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .text = $text;
    .visible = true;
    .canActivate = false;
  }
  return $label;
}

function regsSlider($x, $y, $step) {
  $steps = #$regsDensityValues;
  return MAIN.$ui.createSlider($box.$content, $step * ($steps - 0.01) / ($steps - 1), 0.0, $steps - 0.01, $x, $y, 200, 27);
}

with (regsLabel(270, 362, $regs.$regs_trafficDensity_item)) {
  .setArg(0, macro :: $regs.$regs_density_values[$regsTrafficStep]);
}
$regsTrafficSlider = regsSlider(270, 380, $regsTrafficStep);
$regsTrafficSlider.$action = macro :: regsSetTrafficDensity();
function regsSetTrafficDensity() {
  $regsTrafficStep = int($regsTrafficSlider.$value);
  $regsTrafficDensity = $regsDensityValues[$regsTrafficStep];
}

with (regsLabel(270, 412, $regs.$regs_populationDensity_item)) {
  .setArg(0, macro :: $regs.$regs_density_values[$regsPopulationStep]);
}
$regsPopulationSlider = regsSlider(270, 430, $regsPopulationStep);
$regsPopulationSlider.$action = macro :: regsSetPopulationDensity();
function regsSetPopulationDensity() {
  $regsPopulationStep = int($regsPopulationSlider.$value);
  $regsPopulationDensity = $regsDensityValues[$regsPopulationStep];
}

// map sizes XXL and XXXL (main.script extension): the size label by the full list, the preview kept inside its area
function selectMap($map) {
  regsBaseSelectMap($map);
  $regsSize = 1280;
  $regsScenario = changeFileExt($map, ".scenario");
  if (file_exists($regsScenario)) {
    $regsS = load "/"+$regsScenario;
    if (defined $regsS.$cellSize) $regsSize = $regsS.$cellSize;
    delete $regsS;
  }
  if ($regsSize > 1280 || $regsSize < 512) {
    $sizeTitle.setArg(0, $strings.$menu_mapSize_items[MAIN.$main.regsMapSizeIndex($regsSize)]);
    $mapImage.setRect(($mapArea.clientWidth - 192) * 0.5, ($mapArea.clientHeight - 192) * 0.5, 192, 192);
  }
}
