// ReGS extension of the controls page (metro/ui/menus/controls.script, used as installed; see VM::extendSource).
// Controller (owner's request 2026-11-18, port/docs/controller.md): a fourth category "Controller" next to the game's
// Camera / Shortcuts / Map editor lists, with the port's controller settings and the button legend:
// * $regsController (on): the pad plays the game alongside the mouse and keyboard (engine/gamepad.cpp);
// * $regsControllerCursor, $regsControllerCamera (1.0 = 100 %, 25 .. 250 %): the cursor's and the camera's speed;
// * $regsControllerInvertTilt (off): stick up looks down.
// The legend shows the connected pad's buttons as glyphs (data/regs/ui/pad, drawn at build time by regs-tool
// padglyphs): Xbox, PlayStation, Steam Deck or Steam Controller; switches in its heading show the others. Above its
// rows a picture of that controller with a label and a line to each button (owner 2026-11-23: "look like an
// Xbox/PS5/Steam Controller, silhouette-wise with lines going to the buttons"): body_<layout>.dds (Kenney's CC0
// outlines with the buttons and the leader lines) and the label places in <layout>.layout, both written by regs-tool
// padglyphs.
// They apply on OK like the game's keys (the engine reads them every frame); Cancel keeps the old ones.
//@rename categorySelected regsBaseCategorySelected
//@rename save regsBaseSave

if (file_exists("regs/strings/"+MAIN.$language+".strings")) {
  $regs = load "/regs/strings/"+MAIN.$language+".strings";
} else {
  $regs = load "/regs/strings/en_US.strings";
}

//@base

$regsPadOn = MAIN.$settings.$regsController : true;
$regsPadCursor = MAIN.$settings.$regsControllerCursor : 1.0;
$regsPadCamera = MAIN.$settings.$regsControllerCamera : 1.0;
$regsPadInvert = MAIN.$settings.$regsControllerInvertTilt : false;
$regsPadCategory = #$categoryBar.$buttons;
// the list's checkboxes and sliders: named here at top level, so the functions below share them (a variable first
// set inside a function would be that function's own)
$regsPadOnButton = null;
$regsPadInvertButton = null;
$regsPadCursorSlider = null;
$regsPadCameraSlider = null;
$regsPadLegend = null;          // the legend's rows (rebuilt for another layout)
$regsPadBodies = ["xbox", "playstation", "deck", "steamcontroller"];  // the pictures, in the legends' order
$regsPadDiagramBox = null;      // the picture with its labels (rebuilt for another layout)
$regsPadDiagramH = 274;         // its height (the pictures are 880 x 272)
$regsPadLegendButtons = [];
// the legends: per layout [glyphs, what it does (strings regs_pad_do_<key>)] rows; layouts as regsPadLayout()
// orders them: Xbox, PlayStation, Steam Deck, Steam Controller
$regsPadLegends = [
  [[["xb_ls"], "cursor"], [["xb_lb", "xb_ls"], "panHold"], [["xb_rs"], "turnTilt"], [["xb_rs"], "tiltReset"],
   [["xb_lt", "xb_rt"], "zoom"], [["xb_a"], "click"], [["xb_b"], "rclick"], [["xb_menu"], "esc"],
   [["xb_y"], "construct"], [["xb_x"], "bulldoze"], [["xb_view"], "underground"], [["xb_rb"], "pause"],
   [["dpad_lr"], "speed"], [["dpad_ud"], "panels"], [["xb_ls"], "select"]],
  [[["ps_ls"], "cursor"], [["ps_l1", "ps_ls"], "panHold"], [["ps_rs"], "turnTilt"], [["ps_r3"], "tiltReset"],
   [["ps_l2", "ps_r2"], "zoom"], [["ps_cross"], "click"], [["ps_circle"], "rclick"], [["ps_options"], "esc"],
   [["ps_triangle"], "construct"], [["ps_square"], "bulldoze"], [["ps_create", "ps_touchpad"], "underground"],
   [["ps_r1"], "pause"], [["dpad_lr"], "speed"], [["dpad_ud"], "panels"], [["ps_l3"], "select"]],
  [[["deck_rpad"], "rpad"], [["deck_lpad"], "lpad"], [["deck_l4", "deck_lpad"], "lpadCam"], [["deck_ls"], "cursor"],
   [["deck_l1", "deck_ls"], "panHold"], [["deck_rs"], "turnTilt"], [["deck_r3"], "tiltReset"],
   [["deck_l2", "deck_r2"], "zoom"], [["deck_a"], "click"], [["deck_b", "deck_r4"], "rclick"], [["deck_menu"], "esc"],
   [["deck_y"], "construct"], [["deck_x"], "bulldoze"], [["deck_view"], "underground"], [["deck_r1"], "pause"],
   [["dpad_lr"], "speed"], [["dpad_ud"], "panels"], [["deck_l3"], "select"]],
  [[["sc_rpad"], "rpad"], [["sc_lpad"], "lpadSc"], [["sc_lg", "sc_lpad"], "lpadCam"], [["sc_stick"], "cursor"],
   [["sc_lb", "sc_stick"], "panHold"], [["sc_lt", "sc_rt"], "zoom"], [["sc_a"], "click"], [["sc_b", "sc_rg"], "rclick"],
   [["sc_start"], "esc"], [["sc_y"], "construct"], [["sc_x"], "bulldoze"], [["sc_back"], "underground"],
   [["sc_rb"], "pause"], [["dpad_lr"], "speedSc"], [["dpad_ud"], "panelsSc"], [["sc_stick"], "select"]]
];

// the category button, the four centred as the game centres its three
$regsX = int(($categoryBar.width - ($regsPadCategory + 1) * 129) * 0.5);
foreach ($categoryBar.$buttons) {
  .setRect($regsX, 0, 128, 32);
  $regsX += 129;
}
with ($regsPadButton = MAIN.$ui.createChoiceButton($categoryBar, $categoryBar, $regsX, 0, 128, 32, $regs.$regs_controller_category, macro($categoryBar, $regsPadCategory) :: MAIN.$ui.selectCategory($0, $1), "/metro/ui/category_ia.dds", "/metro/ui/category_se.dds", "/metro/ui/category_ia.dds")) {
  .setMargins(0, 0, 0, 5);
}
$categoryBar.$buttons[] = $regsPadButton;

function categorySelected() {
  $pad = $categoryBar.$category == $regsPadCategory;
  $primaryTitle.visible = !$pad;     // the key columns' headings
  $secondaryTitle.visible = !$pad;
  if (!$pad) {
    regsBaseCategorySelected();
    return;
  }
  $items = [];
  $itemsArea.$content.clear();
  regsPadItems();
  MAIN.$ui.resetScrollArea($itemsArea);
}

// a row of the list: the game's striped background, a text on the left (columns: the left half, or all of it)
function regsPadRow($y, $h, $text, $wide = false, $color = 0xFFCCCCCC) {
  $w = $itemsArea.$content.width;
  with ($row = new_control($itemsArea.$content)) {
    .setRect(0, $y, $w, $h);
    .background = ((int($y / $h) & 1) == 0) ? 0x30000000 : 0x80000000;
    .visible = true;
    .canActivate = false;
  }
  with ($label = new_control($row)) {
    .setRect(8, 0, $wide ? $w - 16 : int($w * 0.5) - 8, $h);
    MAIN.$ui.setTextFont(current, $color);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .text = $text;
    .visible = true;
    .canActivate = false;
  }
  $row.$label = $label;
  return $row;
}

function regsPadStatusText() {
  $s = regsPadStatus();
  $l = regsPadLayout();
  if ($s == 1 && $l == "deck") return $regs.$regs_controller_steaminput_deck;
  if ($s == 1 && $l == "steamcontroller") return $regs.$regs_controller_steaminput_sc;
  if ($s == 1) return $regs.$regs_controller_xbox;
  if ($s == 2) return $regs.$regs_controller_ps;
  if ($s == 3) return $regs.$regs_controller_sim;
  if ($s == 4) return $regs.$regs_controller_deck;
  if ($s == 5) return $regs.$regs_controller_sc;
  return $regs.$regs_controller_none;
}

// the connected pad's layout as an index of $regsPadLegends (Xbox without one)
function regsPadLayoutIndex() {
  $l = regsPadLayout();
  if ($l == "playstation") return 1;
  if ($l == "deck") return 2;
  if ($l == "steamcontroller") return 3;
  return 0;
}

// the controller's picture with its leader lines (body_<layout>.dds, the whole diagram) and the labels' texts over it,
// in the columns left and right of the controller (<layout>.layout: each label's side and height)
function regsPadDiagram($layout) {
  $regsPadDiagramBox.clear();
  $w = $regsPadDiagramBox.width;
  $name = $regsPadBodies[$layout];
  $lay = load "/regs/ui/pad/" + $name + ".layout";
  $ix = int(($w - $lay.$width) * 0.5);
  with ($dia = new_control($regsPadDiagramBox)) {
    .setRect($ix, int(($regsPadDiagramH - $lay.$height) * 0.5), $lay.$width, $lay.$height);
    .setImage("/regs/ui/pad/body_" + $name + ".dds");
    .visible = true;
    .canActivate = false;
  }
  foreach ($lay.$callouts) {
    $c = current;
    $left = $c[0] == 0;
    with (new_control($dia)) {
      if ($left) .setRect(0, $c[1] - 11, $lay.$leftEdge - 5, 22);
      else .setRect($lay.$rightEdge + 5, $c[1] - 11, $lay.$width - $lay.$rightEdge - 5, 22);
      MAIN.$ui.setTextFont(current, 0xFFE6E0D2);
      .textAlign = ALIGN_MIDDLE | ($left ? ALIGN_RIGHT : ALIGN_LEFT);
      .text = $regs.getVariable("regs_pad_tag_" + $c[2]);
      .visible = true;
      .canActivate = false;
    }
  }
  delete $lay;
}

// the legend's rows for a layout: the buttons' glyphs (24 pixels high; "+" between buttons pressed together, "/"
// between alternatives), then what they do
function regsPadShowLegend($layout) {
  MAIN.$ui.selectChoiceButton($regsPadLegendButtons[$layout], $regsPadLegendButtons[0].$group);
  regsPadDiagram($layout);
  $regsPadLegend.clear();
  $w = $regsPadLegend.width;
  $y = 0;
  foreach ($regsPadLegends[$layout]) {
    $entry = current;
    with ($row = new_control($regsPadLegend)) {
      .setRect(0, $y, $w, 30);
      .background = ((int($y / 30) & 1) == 0) ? 0x30000000 : 0x80000000;
      .visible = true;
      .canActivate = false;
    }
    $x = 8;
    $first = true;
    $sep = "/";   // either button; "+" where they are pressed together
    if ($entry[1] == "panHold" || $entry[1] == "lpadCam") $sep = "+";
    foreach ($entry[0]) {
      $glyph = current;
      if (!$first) {
        with (new_control($row)) {
          .setRect($x, 0, 14, 30);
          MAIN.$ui.setTextFont(current);
          .textAlign = ALIGN_MIDDLE | ALIGN_CENTER;
          .text = $sep;
          .visible = true;
          .canActivate = false;
        }
        $x += 14;
      }
      $gw = 24;
      if ($glyph == "ps_create" || $glyph == "ps_options" || $glyph == "ps_touchpad") $gw = 48;
      with (new_control($row)) {
        .setRect($x, 3, $gw, 24);
        .setImage("/regs/ui/pad/" + $glyph + ".dds");
        .visible = true;
        .canActivate = false;
      }
      $x += $gw;
      $first = false;
    }
    with (new_control($row)) {
      .setRect(150, 0, $w - 158, 30);
      MAIN.$ui.setTextFont(current);
      .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
      .text = $regs.getVariable("regs_pad_do_" + $entry[1]);
      .visible = true;
      .canActivate = false;
    }
    $y += 30;
  }
  $regsPadLegend.setRect(0, $regsPadLegend.top, $w, $y);
  MAIN.$ui.resetScrollArea($itemsArea);
}

function regsPadCheckbox($row, $action) {
  return MAIN.$ui.createChoiceButton($row, "self", int($row.width * 0.5), 11, 16, 16, "", $action, "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
}

function regsPadItems() {
  $h = 38;
  $w = $itemsArea.$content.width;
  $half = int($w * 0.5);
  with (regsPadRow(0, $h, $regs.$regs_controller_status, true).$label) {
    .setArg(0, macro :: regsPadStatusText());
  }
  // the controller's picture first (what is seen without scrolling): a heading with the four layouts to choose from,
  // then the picture with its labels
  $y = $h;
  $head = regsPadRow($y, 30, $regs.$regs_controller_legend, true, 0xFFFFFFFF);
  $regsPadLegendButtons = [];
  $bx = $head.width - 4 * 132 - 8;
  for ($i = 0; $i < 4; ++$i) {
    $regsPadLegendButtons[] = MAIN.$ui.createChoiceButton($head, $head, $bx + $i * 132, 4, 128, 22, $regs.$regs_pad_layouts[$i], macro($i) :: regsPadShowLegend($0));
  }
  $y += 30;
  with ($regsPadDiagramBox = new_control($itemsArea.$content)) {
    .setRect(0, $y, $w, $regsPadDiagramH);
    .background = 0x30000000;
    .visible = true;
    .canActivate = false;
  }
  $y += $regsPadDiagramH + 8;

  // the settings
  $row = regsPadRow($y, $h, $regs.$regs_controller_enable);
  $regsPadOnButton = regsPadCheckbox($row, macro :: regsPadSetOn(!$regsPadOn));
  regsPadSetOn($regsPadOn);
  $y += $h;
  with (regsPadRow($y, $h, $regs.$regs_controller_cursor).$label) {
    .setArg(0, macro :: int($regsPadCursor * 100.0 + 0.5));
  }
  $regsPadCursorSlider = MAIN.$ui.createSlider($itemsArea.$content, $regsPadCursor, 0.25, 2.5, $half, $y + 6, 215, 27);
  $regsPadCursorSlider.$action = macro :: regsPadSetCursor();
  $y += $h;
  with (regsPadRow($y, $h, $regs.$regs_controller_camera).$label) {
    .setArg(0, macro :: int($regsPadCamera * 100.0 + 0.5));
  }
  $regsPadCameraSlider = MAIN.$ui.createSlider($itemsArea.$content, $regsPadCamera, 0.25, 2.5, $half, $y + 6, 215, 27);
  $regsPadCameraSlider.$action = macro :: regsPadSetCamera();
  $y += $h;
  $row = regsPadRow($y, $h, $regs.$regs_controller_invert);
  $regsPadInvertButton = regsPadCheckbox($row, macro :: regsPadSetInvert(!$regsPadInvert));
  regsPadSetInvert($regsPadInvert);
  $y += $h + 12;

  // every button of the chosen layout, with what it does in full
  with ($regsPadLegend = new_control($itemsArea.$content)) {
    .setRect(0, $y, $w, 30);
    .visible = true;
    .canActivate = false;
  }
  regsPadShowLegend(regsPadLayoutIndex());
}

function regsPadSetOn($value) {
  $regsPadOn = $value;
  MAIN.$ui.selectChoiceButton($regsPadOn ? $regsPadOnButton : null, $regsPadOnButton);
}

function regsPadSetInvert($value) {
  $regsPadInvert = $value;
  MAIN.$ui.selectChoiceButton($regsPadInvert ? $regsPadInvertButton : null, $regsPadInvertButton);
}

function regsPadSetCursor() {
  $regsPadCursor = $regsPadCursorSlider.$value;
}

function regsPadSetCamera() {
  $regsPadCamera = $regsPadCameraSlider.$value;
}

// the original save() (renamed regsBaseSave) stores the keys, then the controller settings
function save() {
  regsBaseSave();
  MAIN.$settings.$regsController = $regsPadOn;
  MAIN.$settings.$regsControllerCursor = $regsPadCursor;
  MAIN.$settings.$regsControllerCamera = $regsPadCamera;
  MAIN.$settings.$regsControllerInvertTilt = $regsPadInvert;
  MAIN.$settings.exportVariables("regsController", "regsControllerCursor", "regsControllerCamera", "regsControllerInvertTilt");
}
