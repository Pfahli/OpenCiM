// ReGS extension of the map editor (metro/scripts/editor.script, used as installed; see VM::extendSource):
// autosave (owner's request 2026-11-07). While the setting $regsEditorAutosave is on (default; the map attributes
// have the checkbox), the editor saves the map every 5 minutes of editing into userdata/maps/autosave/ as
// "<map> (Autosave n)", n = 1..5 in rotation (the oldest is replaced), so a crash costs at most 5 minutes and the
// manual saves in userdata/maps are never touched. The files are those of a manual save (.grid, .timeline,
// .scenario, .dds); the editor's "load map" list shows them with their time (mainmenu.script extension).

//@base

$regsAutosaveSlots = 5;
// every 5 minutes; a setting of its own ($regsEditorAutosaveSeconds) no shorter than a minute (owner's request
// 2026-11-16: saves every few seconds got in the way); test runs set REGS_AUTOSAVE_SECONDS
$regsAutosaveSeconds = regsEnvNumber("REGS_AUTOSAVE_SECONDS", max(60.0, float(MAIN.$settings.$regsEditorAutosaveSeconds : 300.0)));

function regsTwo($n) {
  if ($n < 10) return "0"+$n;
  return ""+$n;
}

// the slot to write: a free one, else the one saved longest ago
function regsAutosaveSlot($base) {
  $best = 1;
  $bestStamp = -1;
  for ($i = 1; $i <= $regsAutosaveSlots; ++$i) {
    $file = $base+" (Autosave "+$i+").scenario";
    if (!file_exists($file)) return $i;
    $s = load "/"+$file;
    $stamp = $s.$regsAutosaveStamp : 0;
    delete $s;
    if ($bestStamp < 0 || $stamp < $bestStamp) {
      $best = $i;
      $bestStamp = $stamp;
    }
  }
  return $best;
}

function regsAutosave() {
  $file = "regs/strings/"+MAIN.$language+".strings";
  if (!file_exists($file)) $file = "regs/strings/en_US.strings";
  $rs = load "/"+$file;
  $name = changeFileExt(extractFileName(MAIN.$gridFileName), "");
  $cut = findstr($name, " (Autosave ");   // an opened autosave saves under its map's name
  if ($cut > 0) $name = substr($name, 0, $cut);
  if ($name == "") $name = $rs.$regs_autosave_unnamed;
  mkdir("userdata/maps/autosave");
  $base = "userdata/maps/autosave/"+$name;
  $slot = regsAutosaveSlot($base);
  $out = $base+" (Autosave "+$slot+")";
  echo "Autosave \""+$out+"\"";
  MAIN.$player.resetTool();   // no tool previews in the file (as saveMapData)
  $startDate = mkdate(1,1,1920);
  // as saveMapData without touching the editor's state: on the first day the live map holds the day's actions,
  // later days the base grid and the timeline rebuild the map
  if (MAIN.$mainClock.date == $startDate || !file_exists("memory/base.grid")) {
    MAIN.$grid.saveToFile($out+".grid");
  } else {
    copy_file("memory/base.grid", $out+".grid");
  }
  $day = MAIN.$timeline.currentDay;
  MAIN.$timeline.currentDay = 0;
  MAIN.$timeline.saveToFile($out+".timeline");
  MAIN.$timeline.currentDay = $day;
  MAIN.$minimap.$texture.saveToFile($out+".dds");
  $s = load "/metro/scenarios/location.scenario";
  $s.$locationSetup = MAIN.$gridLocation;
  $s.$currentDate = MAIN.$gridStartingDate;
  $s.$cellSize = MAIN.$gridCellSize;
  $s.$cityDescriptionShort = MAIN.$gridDescription;
  $s.$regsPackages = MAIN.$main.regsRequiredPackages();
  $s.$regsSelectedPackages = MAIN.$regsSelectedPackages : [];
  $c = clock(current_time(), current_date());
  $s.$regsAutosaveStamp = $c.date * 1440 + $c.hours * 60 + $c.minutes;
  $s.$regsAutosaveLabel = regsTwo($c.days)+"."+regsTwo($c.months)+". "+regsTwo($c.hours)+":"+regsTwo($c.minutes);
  delete $c;
  $s.exportVariablesTo($out+".scenario", "locationSetup", "currentDate", "cellSize", "cityDescriptionShort", "regsPackages",
                       "regsSelectedPackages", "regsAutosaveStamp", "regsAutosaveLabel");
  delete $s;
  // no message box (owner's request 2026-11-15: the popup every few minutes got in the way); the log has the line
  delete $rs;
}

// the files go out on a background thread, and the save waits while a tool is in the middle of a drag (the
// save cancels it) - checked again every 5 seconds
$regsAutosaveThread = thread :: {
  loop {
    wait $regsAutosaveSeconds;
    while (regsToolBusy(MAIN.$player)) wait 5.0;
    // (not while the OpenStreetMap import builds the new map)
    if ((MAIN.$settings.$regsEditorAutosave : true) && !(MAIN.$regsOsmBusy : false)) {
      MAIN.$ui.regsShowSaveIcon(2.4);   // the blinking disk in the top right corner, drawn before the save starts
      skip_frame;
      MAIN.$regsQuietStatus = true;
      regsAsyncWrites(true);
      regsAutosave();
      regsAsyncWrites(false);
      MAIN.$regsQuietStatus = false;
    }
  }
};

// ---- templates (owner's request 2026-11-07; engine/tool_templates.cpp) ----
// Two buttons in the objects menu: "save template" (drag an area, then name it; saved to userdata/templates) and
// "place template" (pick one, then click on the map: its terrain and objects replace what lies in the area).

function regsStringsNow() {
  $file = "regs/strings/"+MAIN.$language+".strings";
  if (!file_exists($file)) $file = "regs/strings/en_US.strings";
  return load "/"+$file;
}

function regsTemplateCheckName($key) {
  return $key >= 'a' && $key <= 'z' || $key >= 'A' && $key <= 'Z' || $key >= '0' && $key <= '9' || $key >= ',' && $key <= '.' || $key == '_' || $key == ' ' || $key >= 192;
}

// the selection panel (top right, while the select tool is on): what is selected, how Shift works, save / cancel
$regsPanel = null;
$regsPanelInfo = null;
$regsPanelStrings = null;

function regsSaveTemplateTool() {
  $toolbar.selectTool(REGS_GRIDMODE_SELECT_AREA);
  regsClearSelection($grid);
  if ($regsPanel) return;
  $regsPanelStrings = regsStringsNow();
  $regsPanel = MAIN.$ui.createHudElement($desktop.width - 400, 70, 380, 190, 1 | 2 | 4 | 8);
  with ($t = new_control($regsPanel.$content)) {
    .setRect(10, 0, 330, 22);
    .text = $regsPanelStrings.$regs_template_panel_title;
    .visible = true;
    .canActivate = false;
  }
  MAIN.$ui.setTitleFont($t);
  with ($regsPanelInfo = new_control($regsPanel.$content)) {
    .setRect(10, 26, 330, 20);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .visible = true;
    .canActivate = false;
  }
  with ($h = new_control($regsPanel.$content)) {
    .setRect(10, 50, 330, 40);
    MAIN.$ui.setTextFont(current, 0xFFBBBBBB);
    .textAlign = ALIGN_TOP | ALIGN_LEFT;
    .text = $regsPanelStrings.$regs_template_panel_hint;
    .visible = true;
    .canActivate = false;
  }
  with ($regsPanel.$save = MAIN.$ui.createButton($regsPanel.$content, 10, 98, 112, 25, $regsPanelStrings.$regs_template_panel_save, regsSaveSelection, "/metro/ui/ok.dds", "/metro/ui/ok.dds", "/metro/ui/ok.dds")) {
    .setCropRect(8.0 / 128.0, 3.0 / 32.0, 112.0 / 128.0, 25.0 / 32.0);
    .setMargins(14, 0, 0, 0);
  }
  MAIN.$ui.setTitleFont($regsPanel.$save);
  with ($c = MAIN.$ui.createButton($regsPanel.$content, 228, 98, 112, 25, MAIN.$strings.$menu_cancel_button, macro :: $toolbar.selectTool(GRIDMODE_SELECT_OBJECT), "/metro/ui/cancel.dds", "/metro/ui/cancel.dds", "/metro/ui/cancel.dds")) {
    .setCropRect(8.0 / 128.0, 3.0 / 32.0, 112.0 / 128.0, 25.0 / 32.0);
    .setMargins(14, 0, 0, 0);
  }
  MAIN.$ui.setTitleFont($c);
  thread :: {   // the panel follows the selection and goes with the tool
    while ($player.editMode == REGS_GRIDMODE_SELECT_AREA) {
      $sel = regsSelection();
      if ($sel) {
        $regsPanelInfo.text = expandPattern($regsPanelStrings.$regs_template_panel_text, $sel[2], $sel[3], $sel[4]);
      } else {
        $regsPanelInfo.text = $regsPanelStrings.$regs_template_panel_empty;
      }
      $regsPanel.$save.enabled = $sel != null;
      $regsPanel.$save.visibility = $sel != null ? 1.0 : 0.3;
      wait 0.1;
    }
    delete $regsPanel;
    $regsPanel = null;
    delete $regsPanelStrings;
  };
}

// the name dialog (the game's own) gets a checkbox "Gelände speichern" under the name field once it stands; the choice
// is kept for the session
$regsSaveTerrain = true;
$regsTerrainBox = null;

function regsSetSaveTerrain($on) {
  $regsSaveTerrain = $on;
  if ($regsTerrainBox) MAIN.$ui.selectChoiceButton($on ? $regsTerrainBox : null, $regsTerrainBox);
}

function regsSaveSelection() {
  thread :: {
    $rs2 = regsStringsNow();
    $name = "";
    thread :: {   // the checkbox, once the dialog is there
      skip_frame;
      $d = MAIN.$ui.$currentDialog : null;
      if (!$d) return;
      $d.top -= 15;   // room for the checkbox: the dialog 30 px taller, its buttons lower
      $d.height += 30;
      $d.$content.height += 30;
      if ($d.$yesButton) $d.$yesButton.top += 30;
      if ($d.$noButton) $d.$noButton.top += 30;
      $regsTerrainBox = MAIN.$ui.createChoiceButton($d.$content, "self", 12, 76, 16, 16, "", macro :: regsSetSaveTerrain(!$regsSaveTerrain), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
      with ($l = MAIN.$ui.createLabel($d.$content, 34, 74, 240, 20, $rs2.$regs_template_terrain_option)) {
        .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
      }
      regsSetSaveTerrain($regsSaveTerrain);
    };
    $ok = regsSelection() && MAIN.$ui.showDialog($rs2.$regs_template_name_dialog, true, true, true, @$name, regsTemplateCheckName);
    $regsTerrainBox = null;
    if ($ok && $name != "") {
      mkdir("userdata/templates");
      // an OpenCiM template file (.cimtpl, a GS10 package): template.grid, template.dds (the picture), template.info
      // (size, terrain, the DLCs of its objects); the parts are made in memory first
      if ($grid.regsSaveTemplate("memory/template.grid", $regsSaveTerrain)) {
        // the picture: a screenshot of the view's centre, without the interface and the selection highlight
        regsClearSelection($grid);
        $hudWas = MAIN.$hud.visible;
        MAIN.$hud.visible = false;
        $pointer = MAIN.$mouse.$mouse;
        $pointerWas = $pointer.visible;
        $pointer.visible = false;
        skip_frame;
        skip_frame;
        regsCaptureTemplatePreview("memory/template.dds");
        skip_frame;
        skip_frame;
        MAIN.$hud.visible = $hudWas;
        $pointer.visible = $pointerWas;
        writePackage("userdata/templates/"+$name+".cimtpl", ["memory/template.grid", "memory/template.dds", "memory/template.info"]);
        updateFileSystem();
        MAIN.$ui.showStatusMessage($rs2.$regs_template_saved_status);
      }
    }
    delete $rs2;
  };
}

// the template list: the map manager window (regs/ui/mapbrowser.script) on userdata/templates, with the preview
// pictures and the folder buttons; the chosen template goes to the place tool
$regsTemplateFolder = "";

function regsJoin($list) {
  $out = "";
  foreach ($list) $out = $out + ($out == "" ? "" : "|") + current;
  return $out;
}

function regsPlaceTemplateTool() {
  $toolbar.closeSubMenu();
  thread :: {
    mkdir("userdata/templates");
    updateFileSystem();
    $rs = regsStringsNow();
    $b = load "/regs/ui/mapbrowser.script";
    $b.$root = "userdata/templates";
    $b.$title = $rs.$regs_template_browser_title;
    $b.$openText = $rs.$regs_template_place_button;
    $b.$folder = $regsTemplateFolder;
    $ok = $b.run();
    $regsTemplateFolder = $b.$folder;
    $chosen = $b.$value;
    delete $b;
    delete $rs;
    if (!$ok || $chosen == "") return;
    $file = "userdata/templates/"+$chosen;
    if (findstr($chosen, ".cimtpl") > 0) {
      // a template file: its DLCs must be there (or the player places it anyway: missing objects stay out)
      $missing = [];
      if (file_exists($file+"/template.info")) {
        $info = load "/"+$file+"/template.info";
        $installed = map [];
        foreach (MAIN.$main.regsInstalledPackages()) $installed[current] = true;
        $needed = [];
        foreach ($info.$packages : []) {
          if (!(defined $installed[current]) && !MAIN.$main.regsIsBasePackage(current)) $missing[] = current;
          else $needed[] = current;
        }
        delete $info;
        // the installed ones join the map's packages (their buildings and props get loaded, the map lists them)
        MAIN.$level.regsLoadPackages($needed);
        foreach ($needed) {
          if (findstr("|"+regsJoin(MAIN.$regsSelectedPackages : [])+"|", "|"+current+"|") < 0) MAIN.$regsSelectedPackages[] = current;
        }
      }
      $rsm = regsStringsNow();
      $okPlace = MAIN.$main.regsConfirmMissing($missing, $file, $rsm.$regs_template_missing_dialog);
      delete $rsm;
      if (!$okPlace) return;
      $file = $file+"/template.grid";
    }
    if (regsSetTemplate($file)) $toolbar.selectTool(REGS_GRIDMODE_PLACE_TEMPLATE);
  };
}

// the two buttons after the original's in the objects tab, with the menu icons for saving and loading
$regsObjectsTab = $objectsMenu.$tabs["objects"];
$regsRs = regsStringsNow();
foreach ([["/metro/ui/menus/save.dds", regsSaveTemplateTool, $regsRs.$regs_template_save_hint],
          ["/metro/ui/menus/load.dds", regsPlaceTemplateTool, $regsRs.$regs_template_place_hint]]) {
  $regsN = $regsObjectsTab.getChildCount();
  $regsB = MAIN.$ui.createChoiceButton($regsObjectsTab, null, $regsN % 5 * 56, $regsN / 5 * 56, 46, 46, "", current[1], current[0], current[0], current[0]);
  $regsB.setCropRect(0.1, 0.1, 0.8, 0.8);
  MAIN.$ui.setTooltip($regsB, current[2], 0, 1);
}
delete $regsRs;

// OpenStreetMap import (port/src/engine/osm.cpp, regs/ui/osmwindow.script): a new map whose dialog chose an area
// (MAIN.$regsOsmPending) gets it built once the editor stands
if (MAIN.$regsOsmPending : false) {
  thread :: {
    skip_frame;
    skip_frame;
    $regsOsm = load "/regs/ui/osmwindow.script";
    $regsOsm.runImport();
    delete $regsOsm;
  };
}
// ---- curved roads (owner's request 2026-11-07; engine/tool_curves.cpp, like the road tool of Cities: Skylines) ----
// All in the traffic menu (owner's wish 2026-11-08: no separate panels):
// * the alley, small-road, large-road and avenue tabs get the curve tool's shapes after their own buttons: straight (at
//   any angle), curve, freeform (the game's bulldozer removes curves: tool_curves.cpp);
// * a road type "One-way" (small roads, the way it is drawn): 1 lane / 2 lanes, then the shapes;
// * a road type "Roundabout": 1 lane / 2 lanes (centre, then size: two clicks).
// What the next click does, the road's length and angle show under the mouse pointer (below the game's price line).
// Icons: the game's own where one fits (bulldozer), else in its style (generated with Magnific from its road icons,
// fitted by tools/make-toolbar-icon.ps1: data/regs/ui/toolbar).
$regsCursorInfo = null;
$regsCurveStrings = null;
$regsCurveUi = "";          // "curve" or "round": what the tool is doing
$regsRoundLanes = 2;
$regsOneWayLanes = 1;
$regsOneWayShape = 1;

// an icon button (the game's 64x64 toolbar icons with _se / _ho variants, the 46x46 middle shown) in a menu tab
function regsIconButton($parent, $group, $x, $y, $icon, $action, $tooltip) {
  $b = MAIN.$ui.createChoiceButton($parent, $group, $x, $y, 46, 46, "", $action, $icon + ".dds", $icon + "_se.dds", $icon + "_ho.dds");
  $b.setCropRect(9.0 / 64.0, 9.0 / 64.0, 46.0 / 64.0, 46.0 / 64.0);
  MAIN.$ui.setTooltip($b, $tooltip, 0, 1);
  return $b;
}

// a road type in the menu's top row with its own tab (as submenu.script's addTypeButton, with the port's icon and tooltip:
// the game's strings have no tool_<type>_hint for it)
function regsAddRoadType($type, $tooltip) {
  $m = $trafficMenu;
  $n = #$m.$typeButtons;
  $icon = "/regs/ui/toolbar/" + $type;
  $b = MAIN.$ui.createChoiceButton($m.$typeButtonArea, $m.$typeButtonArea, $n % 5 * 56, $n / 5 * 56, 46, 46, "", macro($type) :: $trafficMenu.selectTab($0), $icon + ".dds", $icon + "_se.dds", $icon + "_ho.dds");
  $b.setCropRect(9.0 / 64.0, 9.0 / 64.0, 46.0 / 64.0, 46.0 / 64.0);
  MAIN.$ui.setTooltip($b, $tooltip, 0, 1);
  $m.$typeButtons[] = $b;
  $m.$border.top = 70 + $n / 5 * 56;
  $m.$tabArea.top = 92 + $n / 5 * 56;
  $t = new_control($m.$tabArea);
  $t.setRect(0, 0, $m.$tabArea.width, $m.$tabArea.height);
  $t.visible = false;
  $t.canActivate = false;
  $m.$tabs[$type] = $t;
  return $t;
}

function regsTabButton($tab, $group, $icon, $action, $tooltip) {
  $n = $tab.getChildCount();
  return regsIconButton($tab, $group, $n % 5 * 56, $n / 5 * 56, $icon, $action, $tooltip);
}

// the info line under the pointer while the tool is on
function regsCursorInfoStart() {
  if ($regsCursorInfo) return;
  $regsCurveStrings = regsStringsNow();
  with ($regsCursorInfo = new_control($desktop.mouse)) {
    .setRect(0, 62, 420, 40);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_TOP | ALIGN_LEFT;
    .visible = true;
    .canActivate = false;
    .clickThrough = true;
  }
  thread :: {
    while ($player.editMode == REGS_GRIDMODE_CURVE_ROAD) {
      $ci = regsCurveToolInfo();
      $s = $regsCurveStrings;
      if ($regsCurveUi == "round") {
        $regsCursorInfo.text = $ci[0] == 0 ? $s.$regs_curve_info_centre : expandPattern($s.$regs_curve_info_radius, int($ci[1] + 0.5), $regsRoundLanes) + ($ci[3] ? "" : "  " + $s.$regs_curve_info_bad);
      } else if (regsCurveToolMode() == 3) {
        $regsCursorInfo.text = $ci[4] ? $s.$regs_curve_info_remove : $s.$regs_curve_info_pick;
      } else if ($ci[0] == 0) {
        $regsCursorInfo.text = $s.$regs_curve_info_start;
      } else if (regsCurveToolMode() == 1 && $ci[0] == 1) {
        $regsCursorInfo.text = $s.$regs_curve_info_bend + "\n" + $s.$regs_curve_panel_hint2;
      } else {
        $regsCursorInfo.text = expandPattern($s.$regs_curve_info_length, int($ci[1] + 0.5), int($ci[2] + 0.5)) + ($ci[3] ? "" : "  " + $s.$regs_curve_info_bad) + "\n" + $s.$regs_curve_panel_hint2;
      }
      wait 0.1;
    }
    delete $regsCursorInfo;
    $regsCursorInfo = null;
  };
}

// the curve tool: road kind (0 small, 1 large, 2 avenue, 3 alley), direction (0 both ways, 1 / 2: one-way with that
// many lanes, small roads), shape (0 straight, 1 curve, 2 freeform, 3 remove)
function regsCurveToolFor($k, $way, $shape) {
  $regsCurveUi = "curve";
  regsCurveToolKind($k);
  $toolbar.selectTool(REGS_GRIDMODE_CURVE_ROAD);
  regsCurveToolMode($shape);
  regsCurveToolOneWay($k <= 2 ? $way : 0);
  regsCurveToolBridge(false);
  regsCursorInfoStart();
}

// a curved bridge of road kind k (0 small, 1 large, 2 avenue): the curve tool in curve mode, laying bridges (the deck two
// cells over the ground, the kind's bridge span and pillars)
function regsCurveBridgeFor($k) {
  regsCurveToolFor($k, 0, 1);
  regsCurveToolBridge(true);
}

// a curved tunnel of road kind k: the curve tool in curve mode, laying tunnels (the tube under the ground, a portal at
// each open end; the ground over the tube at least as high as the portal: 6 over the road)
function regsCurveTunnelFor($k) {
  regsCurveToolFor($k, 0, 1);
  regsCurveToolBridge(2);
}

// the one-way tab's lane buttons: 1 / 2 a small road with one / two lanes, 3 a large road, 4 an avenue (all lanes one way)
function regsOneWayFor($n, $shape) {
  if ($n <= 2) regsCurveToolFor(0, $n, $shape);
  else regsCurveToolFor($n - 2, 2, $shape);
}

function regsOneWayLanesSet($n) {
  $regsOneWayLanes = $n;
  regsOneWayFor($n, $regsOneWayShape);
}

function regsOneWayShapeSet($m) {
  $regsOneWayShape = $m;
  regsOneWayFor($regsOneWayLanes, $m);
}

// 1 / 2: a small-road ring with one / two lanes; 3 a large-road ring, 4 an avenue ring (all their lanes)
function regsRoundaboutTool($n) {
  $regsRoundLanes = $n;
  $regsCurveUi = "round";
  regsCurveToolKind($n <= 2 ? 0 : $n - 2);
  $toolbar.selectTool(REGS_GRIDMODE_CURVE_ROAD);
  regsCurveToolMode($n == 1 ? 4 : 5);
  regsCursorInfoStart();
}

$regsRs = regsStringsNow();
$regsShapeTips = [$regsRs.$regs_curve_mode_straight, $regsRs.$regs_curve_mode_curved, $regsRs.$regs_curve_mode_freeform, $regsRs.$regs_curve_mode_remove];
// the shapes in the road tabs (the curve icon of the tab's road kind)
$regsCurveTabs = ["alley", "smallroad", "largeroad", "avenue", "express"];
$regsCurveKinds = [3, 0, 1, 2, 7];
$regsCurveIcons = ["curve-alley", "curve-small", "curve-large", "curve-avenue", "curve-avenue"];  // express: the avenue's icon
for ($regsI = 0; $regsI < 5; ++$regsI) {
  $regsTab = $trafficMenu.$tabs[$regsCurveTabs[$regsI]];
  $regsShapeIcons = ["/regs/ui/toolbar/straight-free", "/regs/ui/toolbar/" + $regsCurveIcons[$regsI], "/regs/ui/toolbar/curve-free"];
  for ($regsJ = 0; $regsJ < 3; ++$regsJ) {
    regsTabButton($regsTab, null, $regsShapeIcons[$regsJ], macro($regsCurveKinds[$regsI], $regsJ) :: regsCurveToolFor($0, 0, $1), $regsShapeTips[$regsJ]);
  }
  if ($regsCurveKinds[$regsI] <= 2 || $regsCurveKinds[$regsI] == 7)  // roads: a curved bridge, with the game's bridge icon of the tab
    regsTabButton($regsTab, null, "/metro/ui/toolbar/" + $regsCurveTabs[$regsI] + "-bridge", macro($regsCurveKinds[$regsI]) :: regsCurveBridgeFor($0), $regsRs.$regs_curve_bridge_hint);
  if ($regsCurveKinds[$regsI] <= 2 || $regsCurveKinds[$regsI] == 7)  // and a curved tunnel, with the tab's tunnel icon
    regsTabButton($regsTab, null, "/metro/ui/toolbar/" + $regsCurveTabs[$regsI] + "-tunnel", macro($regsCurveKinds[$regsI]) :: regsCurveTunnelFor($0), $regsRs.$regs_curve_tunnel_hint);
}
// the express tab's ramps (kind 8): on the ground and elevated, drawn as curves (start, bend point, end); an end near an
// express road takes its entry or exit
$regsTab = $trafficMenu.$tabs["express"];
regsTabButton($regsTab, null, "/metro/ui/toolbar/express-ramp", macro :: regsCurveToolFor(8, 0, 1), $regsRs.$regs_curve_ramp_hint);
regsTabButton($regsTab, null, "/metro/ui/toolbar/express-eramp", macro :: regsCurveBridgeFor(8), $regsRs.$regs_curve_eramp_hint);
// the road types One-way and Roundabout in the menu's top row
$regsTab = regsAddRoadType("oneway", $regsRs.$regs_type_oneway_hint);
regsTabButton($regsTab, "regsOneWayLanes", "/regs/ui/toolbar/oneway-1", macro :: regsOneWayLanesSet(1), $regsRs.$regs_oneway1_hint);
regsTabButton($regsTab, "regsOneWayLanes", "/regs/ui/toolbar/oneway-2", macro :: regsOneWayLanesSet(2), $regsRs.$regs_oneway2_hint);
regsTabButton($regsTab, "regsOneWayLanes", "/regs/ui/toolbar/curve-large", macro :: regsOneWayLanesSet(3), $regsRs.$regs_oneway_large_hint);
regsTabButton($regsTab, "regsOneWayLanes", "/regs/ui/toolbar/curve-avenue", macro :: regsOneWayLanesSet(4), $regsRs.$regs_oneway_avenue_hint);
$regsShapeIcons = ["/regs/ui/toolbar/straight-free", "/regs/ui/toolbar/curve-small", "/regs/ui/toolbar/curve-free"];
for ($regsJ = 0; $regsJ < 3; ++$regsJ) {
  // the shapes on the tab's second row
  $regsB = MAIN.$ui.createChoiceButton($regsTab, "regsOneWayShapes", $regsJ * 56, 56, 46, 46, "", macro($regsJ) :: regsOneWayShapeSet($0), $regsShapeIcons[$regsJ] + ".dds", $regsShapeIcons[$regsJ] + "_se.dds", $regsShapeIcons[$regsJ] + "_ho.dds");
  $regsB.setCropRect(9.0 / 64.0, 9.0 / 64.0, 46.0 / 64.0, 46.0 / 64.0);
  MAIN.$ui.setTooltip($regsB, $regsShapeTips[$regsJ], 0, 1);
  if ($regsJ == $regsOneWayShape) MAIN.$ui.selectChoiceButton($regsB, "regsOneWayShapes");
}
$regsTab = regsAddRoadType("roundabout", $regsRs.$regs_round_tooltip);
regsTabButton($regsTab, null, "/regs/ui/toolbar/roundabout-1", macro :: regsRoundaboutTool(1), $regsRs.$regs_round_one);
regsTabButton($regsTab, null, "/regs/ui/toolbar/roundabout", macro :: regsRoundaboutTool(2), $regsRs.$regs_round_two);
regsTabButton($regsTab, null, "/regs/ui/toolbar/curve-large", macro :: regsRoundaboutTool(3), $regsRs.$regs_round_large);
regsTabButton($regsTab, null, "/regs/ui/toolbar/curve-avenue", macro :: regsRoundaboutTool(4), $regsRs.$regs_round_avenue);
// tracks on curves (owner's request 2026-11-08): the build menu's metro tab gets the shapes for ground and elevated
// metro tracks, the traffic menu's track tab those for the railway (curve kinds 4, 5, 6)
$regsTrackTabs = [$buildMenu.$tabs["metro"], $buildMenu.$tabs["metro"], $trafficMenu.$tabs["track"]];
$regsTrackNames = [$regsRs.$regs_track_ground, $regsRs.$regs_track_elevated, $regsRs.$regs_track_rail];
$regsShapeIcons = ["/regs/ui/toolbar/straight-free", "/regs/ui/toolbar/curve-small", "/regs/ui/toolbar/curve-free"];
for ($regsI = 0; $regsI < 3; ++$regsI) {
  for ($regsJ = 0; $regsJ < 3; ++$regsJ) {
    regsTabButton($regsTrackTabs[$regsI], null, $regsShapeIcons[$regsJ], macro($regsI + 4, $regsJ) :: regsCurveToolFor($0, 0, $1), $regsTrackNames[$regsI] + ": " + $regsShapeTips[$regsJ]);
  }
}
delete $regsRs;

// ---- free turn of objects (owner's request 2026-11-08; engine/tools.cpp toolWheel) ----
// Shift + mouse wheel turns the object being placed without steps (5° per notch, with Ctrl too 0.5°; touchpads turn
// smoothly); the right button still turns by 90°. Under the pointer: the hint, once turned the angle.
$regsTurnInfo = null;
$regsTurnStrings = regsStringsNow();
$regsTurnThread = thread :: {
  loop {
    wait 0.1;
    $regsTurnShow = false;
    if ($player.editMode == GRIDMODE_PLACE_OBJECT) {
      $regsTurnState = regsPlaceToolTurn($player);
      $regsTurnShow = $regsTurnState[2] == 1;
    }
    if ($regsTurnShow) {
      if (!$regsTurnInfo) {
        with ($regsTurnInfo = new_control($desktop.mouse)) {
          .setRect(0, 62, 420, 40);
          MAIN.$ui.setTextFont(current);
          .textAlign = ALIGN_TOP | ALIGN_LEFT;
          .visible = true;
          .canActivate = false;
          .clickThrough = true;
        }
      }
      $regsTurnTenths = int($regsTurnState[0] * 10 + 0.5) % 3600;
      if ($regsTurnState[3] == 1) $regsTurnInfo.text = expandPattern($regsTurnStrings.$regs_turn_snap, int($regsTurnTenths / 10), $regsTurnTenths % 10);
      else if ($regsTurnState[1] == 0) $regsTurnInfo.text = $regsTurnStrings.$regs_turn_hint;
      else $regsTurnInfo.text = expandPattern($regsTurnStrings.$regs_turn_info, int($regsTurnTenths / 10), $regsTurnTenths % 10);
    } else if ($regsTurnInfo) {
      delete $regsTurnInfo;
      $regsTurnInfo = null;
    }
  }
};

// ---- the OpenStreetMap import's satellite picture on the ground (engine/osm.h GroundOverlay, terrain.cpp
// collectGroundOverlay; owner's request 2026-11-07: editor only, a map button by the minimap) ----
// A button above the minimap's own two, there once the map has a picture (it belongs to the map it was imported onto
// and is not saved); it lays the picture on the ground or takes it away. Icon: tools/make-satellite-icon.ps1.
$regsSatStrings = regsStringsNow();
$regsSatIcons = MAIN.$minimap.$icons;
$regsSatBox = MAIN.$ui.createHudElement($regsSatIcons.left, $regsSatIcons.top - 49, 52, 59, 2);
$regsSatBox.$content.setRect(1, 10, $regsSatBox.width, 49);
$regsSatButton = MAIN.$ui.createChoiceButton($regsSatBox.$content, "self", 0, 0, 46, 49, "", regsSatToggle,
                                             "/regs/ui/minimap/satellite.dds", "/regs/ui/minimap/satellite_se.dds",
                                             "/regs/ui/minimap/satellite_ho.dds");
$regsSatButton.setCropRect(8.0 / 64.0, 8.0 / 64.0, 46.0 / 64.0, 49.0 / 64.0);
MAIN.$ui.unselectChoiceButton($regsSatButton, $regsSatButton);
MAIN.$ui.setTooltip($regsSatButton, $regsSatStrings.$regs_osm_overlay, 1, 0);
$regsSatBox.visible = false;

function regsSatUpdate() {
  $regsSatState = regsOsmOverlay();  // 0 none for this map, 1 hidden, 2 shown
  $regsSatBox.visible = $regsSatState > 0;
  if ($regsSatState == 2) MAIN.$ui.selectChoiceButton($regsSatButton, $regsSatButton);
  else MAIN.$ui.unselectChoiceButton($regsSatButton, $regsSatButton);
}

function regsSatToggle() {
  regsOsmShowOverlay(regsOsmOverlay() != 2);
  regsSatUpdate();
}

$regsSatThread = thread :: {
  loop {
    wait 0.5;
    regsSatUpdate();
  }
};
