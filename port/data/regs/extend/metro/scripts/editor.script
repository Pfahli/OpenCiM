// ReGS extension of the map editor (metro/scripts/editor.script, used as installed; see VM::extendSource):
// autosave (owner's request 2026-11-07). While the setting $regsEditorAutosave is on (default; the map attributes
// have the checkbox), the editor saves the map every 5 minutes of editing into userdata/maps/autosave/ as
// "<map> (Autosave n)", n = 1..5 in rotation (the oldest is replaced), so a crash costs at most 5 minutes and the
// manual saves in userdata/maps are never touched. The files are those of a manual save (.grid, .timeline,
// .scenario, .dds); the editor's "load map" list shows them with their time (mainmenu.script extension).

//@base

$regsAutosaveSlots = 5;
$regsAutosaveSeconds = MAIN.$settings.$regsEditorAutosaveSeconds : 300.0;   // tests set it shorter

function regsTwo($n) {
  if ($n < 10) return "0"+$n;
  return ""+$n;
}

// the slot to write: a free one, else the one saved longest ago
function regsAutosaveSlot($base) {
  $best = 1;
  $bestStamp = -1;
  for ($i = 1; $i <= $regsAutosaveSlots; ++$i) {
    $file = $base+" (Autosave "+$i+").scenario";
    if (!file_exists($file)) return $i;
    $s = load "/"+$file;
    $stamp = $s.$regsAutosaveStamp : 0;
    delete $s;
    if ($bestStamp < 0 || $stamp < $bestStamp) {
      $best = $i;
      $bestStamp = $stamp;
    }
  }
  return $best;
}

function regsAutosave() {
  $file = "regs/strings/"+MAIN.$language+".strings";
  if (!file_exists($file)) $file = "regs/strings/en_US.strings";
  $rs = load "/"+$file;
  $name = changeFileExt(extractFileName(MAIN.$gridFileName), "");
  $cut = findstr($name, " (Autosave ");   // an opened autosave saves under its map's name
  if ($cut > 0) $name = substr($name, 0, $cut);
  if ($name == "") $name = $rs.$regs_autosave_unnamed;
  mkdir("userdata/maps/autosave");
  $base = "userdata/maps/autosave/"+$name;
  $slot = regsAutosaveSlot($base);
  $out = $base+" (Autosave "+$slot+")";
  echo "Autosave \""+$out+"\"";
  MAIN.$player.resetTool();   // no tool previews in the file (as saveMapData)
  $startDate = mkdate(1,1,1920);
  // as saveMapData without touching the editor's state: on the first day the live map holds the day's actions,
  // later days the base grid and the timeline rebuild the map
  if (MAIN.$mainClock.date == $startDate || !file_exists("memory/base.grid")) {
    MAIN.$grid.saveToFile($out+".grid");
  } else {
    copy_file("memory/base.grid", $out+".grid");
  }
  $day = MAIN.$timeline.currentDay;
  MAIN.$timeline.currentDay = 0;
  MAIN.$timeline.saveToFile($out+".timeline");
  MAIN.$timeline.currentDay = $day;
  MAIN.$minimap.$texture.saveToFile($out+".dds");
  $s = load "/metro/scenarios/location.scenario";
  $s.$locationSetup = MAIN.$gridLocation;
  $s.$currentDate = MAIN.$gridStartingDate;
  $s.$cellSize = MAIN.$gridCellSize;
  $s.$cityDescriptionShort = MAIN.$gridDescription;
  $s.$regsPackages = MAIN.$main.regsRequiredPackages();
  $s.$regsSelectedPackages = MAIN.$regsSelectedPackages : [];
  $c = clock(current_time(), current_date());
  $s.$regsAutosaveStamp = $c.date * 1440 + $c.hours * 60 + $c.minutes;
  $s.$regsAutosaveLabel = regsTwo($c.days)+"."+regsTwo($c.months)+". "+regsTwo($c.hours)+":"+regsTwo($c.minutes);
  delete $c;
  $s.exportVariablesTo($out+".scenario", "locationSetup", "currentDate", "cellSize", "cityDescriptionShort", "regsPackages",
                       "regsSelectedPackages", "regsAutosaveStamp", "regsAutosaveLabel");
  delete $s;
  MAIN.$ui.showStatusMessage($rs.$regs_autosave_status);
  delete $rs;
}

$regsAutosaveThread = thread :: {
  loop {
    wait $regsAutosaveSeconds;
    if (MAIN.$settings.$regsEditorAutosave : true) regsAutosave();
  }
};

// ---- templates (owner's request 2026-11-07; engine/tool_templates.cpp) ----
// Two buttons in the objects menu: "save template" (drag an area, then name it; saved to userdata/templates) and
// "place template" (pick one, then click on the map: its terrain and objects replace what lies in the area).

function regsStringsNow() {
  $file = "regs/strings/"+MAIN.$language+".strings";
  if (!file_exists($file)) $file = "regs/strings/en_US.strings";
  return load "/"+$file;
}

function regsTemplateCheckName($key) {
  return $key >= 'a' && $key <= 'z' || $key >= 'A' && $key <= 'Z' || $key >= '0' && $key <= '9' || $key >= ',' && $key <= '.' || $key == '_' || $key == ' ' || $key >= 192;
}

// the selection panel (top right, while the select tool is on): what is selected, how Shift works, save / cancel
$regsPanel = null;
$regsPanelInfo = null;
$regsPanelStrings = null;

function regsSaveTemplateTool() {
  $toolbar.selectTool(REGS_GRIDMODE_SELECT_AREA);
  regsClearSelection($grid);
  if ($regsPanel) return;
  $regsPanelStrings = regsStringsNow();
  $regsPanel = MAIN.$ui.createHudElement($desktop.width - 400, 70, 380, 190, 1 | 2 | 4 | 8);
  with ($t = new_control($regsPanel.$content)) {
    .setRect(10, 0, 330, 22);
    .text = $regsPanelStrings.$regs_template_panel_title;
    .visible = true;
    .canActivate = false;
  }
  MAIN.$ui.setTitleFont($t);
  with ($regsPanelInfo = new_control($regsPanel.$content)) {
    .setRect(10, 26, 330, 20);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .visible = true;
    .canActivate = false;
  }
  with ($h = new_control($regsPanel.$content)) {
    .setRect(10, 50, 330, 40);
    MAIN.$ui.setTextFont(current, 0xFFBBBBBB);
    .textAlign = ALIGN_TOP | ALIGN_LEFT;
    .text = $regsPanelStrings.$regs_template_panel_hint;
    .visible = true;
    .canActivate = false;
  }
  with ($regsPanel.$save = MAIN.$ui.createButton($regsPanel.$content, 10, 98, 112, 25, $regsPanelStrings.$regs_template_panel_save, regsSaveSelection, "/metro/ui/ok.dds", "/metro/ui/ok.dds", "/metro/ui/ok.dds")) {
    .setCropRect(8.0 / 128.0, 3.0 / 32.0, 112.0 / 128.0, 25.0 / 32.0);
    .setMargins(14, 0, 0, 0);
  }
  MAIN.$ui.setTitleFont($regsPanel.$save);
  with ($c = MAIN.$ui.createButton($regsPanel.$content, 228, 98, 112, 25, MAIN.$strings.$menu_cancel_button, macro :: $toolbar.selectTool(GRIDMODE_SELECT_OBJECT), "/metro/ui/cancel.dds", "/metro/ui/cancel.dds", "/metro/ui/cancel.dds")) {
    .setCropRect(8.0 / 128.0, 3.0 / 32.0, 112.0 / 128.0, 25.0 / 32.0);
    .setMargins(14, 0, 0, 0);
  }
  MAIN.$ui.setTitleFont($c);
  thread :: {   // the panel follows the selection and goes with the tool
    while ($player.editMode == REGS_GRIDMODE_SELECT_AREA) {
      $sel = regsSelection();
      if ($sel) {
        $regsPanelInfo.text = expandPattern($regsPanelStrings.$regs_template_panel_text, $sel[2], $sel[3], $sel[4]);
      } else {
        $regsPanelInfo.text = $regsPanelStrings.$regs_template_panel_empty;
      }
      $regsPanel.$save.enabled = $sel != null;
      $regsPanel.$save.visibility = $sel != null ? 1.0 : 0.3;
      wait 0.1;
    }
    delete $regsPanel;
    $regsPanel = null;
    delete $regsPanelStrings;
  };
}

// the name dialog (the game's own) gets a checkbox "Gelände speichern" under the name field once it stands; the choice
// is kept for the session
$regsSaveTerrain = true;
$regsTerrainBox = null;

function regsSetSaveTerrain($on) {
  $regsSaveTerrain = $on;
  if ($regsTerrainBox) MAIN.$ui.selectChoiceButton($on ? $regsTerrainBox : null, $regsTerrainBox);
}

function regsSaveSelection() {
  thread :: {
    $rs2 = regsStringsNow();
    $name = "";
    thread :: {   // the checkbox, once the dialog is there
      skip_frame;
      $d = MAIN.$ui.$currentDialog : null;
      if (!$d) return;
      $d.top -= 15;   // room for the checkbox: the dialog 30 px taller, its buttons lower
      $d.height += 30;
      $d.$content.height += 30;
      if ($d.$yesButton) $d.$yesButton.top += 30;
      if ($d.$noButton) $d.$noButton.top += 30;
      $regsTerrainBox = MAIN.$ui.createChoiceButton($d.$content, "self", 12, 76, 16, 16, "", macro :: regsSetSaveTerrain(!$regsSaveTerrain), "/metro/ui/menus/checkbox.dds", "/metro/ui/menus/checkbox_se.dds", "/metro/ui/menus/checkbox.dds");
      with ($l = MAIN.$ui.createLabel($d.$content, 34, 74, 240, 20, $rs2.$regs_template_terrain_option)) {
        .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
      }
      regsSetSaveTerrain($regsSaveTerrain);
    };
    $ok = regsSelection() && MAIN.$ui.showDialog($rs2.$regs_template_name_dialog, true, true, true, @$name, regsTemplateCheckName);
    $regsTerrainBox = null;
    if ($ok && $name != "") {
      mkdir("userdata/templates");
      // an OpenCiM template file (.cimtpl, a GS10 package): template.grid, template.dds (the picture), template.info
      // (size, terrain, the DLCs of its objects); the parts are made in memory first
      if ($grid.regsSaveTemplate("memory/template.grid", $regsSaveTerrain)) {
        // the picture: a screenshot of the view's centre, without the interface and the selection highlight
        regsClearSelection($grid);
        $hudWas = MAIN.$hud.visible;
        MAIN.$hud.visible = false;
        $pointer = MAIN.$mouse.$mouse;
        $pointerWas = $pointer.visible;
        $pointer.visible = false;
        skip_frame;
        skip_frame;
        regsCaptureTemplatePreview("memory/template.dds");
        skip_frame;
        skip_frame;
        MAIN.$hud.visible = $hudWas;
        $pointer.visible = $pointerWas;
        writePackage("userdata/templates/"+$name+".cimtpl", ["memory/template.grid", "memory/template.dds", "memory/template.info"]);
        updateFileSystem();
        MAIN.$ui.showStatusMessage($rs2.$regs_template_saved_status);
      }
    }
    delete $rs2;
  };
}

// the template list: the map manager window (regs/ui/mapbrowser.script) on userdata/templates, with the preview
// pictures and the folder buttons; the chosen template goes to the place tool
$regsTemplateFolder = "";

function regsJoin($list) {
  $out = "";
  foreach ($list) $out = $out + ($out == "" ? "" : "|") + current;
  return $out;
}

function regsPlaceTemplateTool() {
  $toolbar.closeSubMenu();
  thread :: {
    mkdir("userdata/templates");
    updateFileSystem();
    $rs = regsStringsNow();
    $b = load "/regs/ui/mapbrowser.script";
    $b.$root = "userdata/templates";
    $b.$title = $rs.$regs_template_browser_title;
    $b.$openText = $rs.$regs_template_place_button;
    $b.$folder = $regsTemplateFolder;
    $ok = $b.run();
    $regsTemplateFolder = $b.$folder;
    $chosen = $b.$value;
    delete $b;
    delete $rs;
    if (!$ok || $chosen == "") return;
    $file = "userdata/templates/"+$chosen;
    if (findstr($chosen, ".cimtpl") > 0) {
      // a template file: its DLCs must be there (or the player places it anyway: missing objects stay out)
      $missing = [];
      if (file_exists($file+"/template.info")) {
        $info = load "/"+$file+"/template.info";
        $installed = map [];
        foreach (MAIN.$main.regsInstalledPackages()) $installed[current] = true;
        $needed = [];
        foreach ($info.$packages : []) {
          if (!(defined $installed[current]) && !MAIN.$main.regsIsBasePackage(current)) $missing[] = current;
          else $needed[] = current;
        }
        delete $info;
        // the installed ones join the map's packages (their buildings and props get loaded, the map lists them)
        MAIN.$level.regsLoadPackages($needed);
        foreach ($needed) {
          if (findstr("|"+regsJoin(MAIN.$regsSelectedPackages : [])+"|", "|"+current+"|") < 0) MAIN.$regsSelectedPackages[] = current;
        }
      }
      $rsm = regsStringsNow();
      $okPlace = MAIN.$main.regsConfirmMissing($missing, $file, $rsm.$regs_template_missing_dialog);
      delete $rsm;
      if (!$okPlace) return;
      $file = $file+"/template.grid";
    }
    if (regsSetTemplate($file)) $toolbar.selectTool(REGS_GRIDMODE_PLACE_TEMPLATE);
  };
}

// the two buttons after the original's in the objects tab, with the menu icons for saving and loading
$regsObjectsTab = $objectsMenu.$tabs["objects"];
$regsRs = regsStringsNow();
foreach ([["/metro/ui/menus/save.dds", regsSaveTemplateTool, $regsRs.$regs_template_save_hint],
          ["/metro/ui/menus/load.dds", regsPlaceTemplateTool, $regsRs.$regs_template_place_hint]]) {
  $regsN = $regsObjectsTab.getChildCount();
  $regsB = MAIN.$ui.createChoiceButton($regsObjectsTab, null, $regsN % 5 * 56, $regsN / 5 * 56, 46, 46, "", current[1], current[0], current[0], current[0]);
  $regsB.setCropRect(0.1, 0.1, 0.8, 0.8);
  MAIN.$ui.setTooltip($regsB, current[2], 0, 1);
}
delete $regsRs;

// ---- curved roads (owner's request 2026-11-07; engine/tool_curves.cpp, like the road tool of Cities: Skylines) ----
// A "Curve" button in the alley, small-road, large-road and avenue tabs selects the tool for that road; a panel (top
// right, while the tool is on) offers its modes Straight / Curved / Freeform / Remove and shows what the next click
// does, the road's length and angle. Roundabouts have their own button and panel (small-road tab): one or two lanes,
// the centre and then the size with two clicks (the same engine tool in its modes 4 and 5).
$regsCurvePanel = null;
$regsCurveStrings = null;
$regsCurveInfo = null;
$regsCurveUi = "";          // which panel the tool shows: "curve" or "round"
$regsRoundPanel = null;
$regsRoundInfo = null;
$regsRoundLanes = 2;
$regsRoundStrings = null;

function regsCurveMode($m) {
  regsCurveToolMode($m);
}

function regsCurveTool() {
  $regsCurveUi = "curve";
  $toolbar.selectTool(REGS_GRIDMODE_CURVE_ROAD);
  regsCurveToolMode(regsCurveToolMode() >= 4 ? 1 : regsCurveToolMode());   // a fresh start (not a roundabout)
  if ($regsCurvePanel) return;
  $regsCurveStrings = regsStringsNow();
  $regsCurvePanel = MAIN.$ui.createHudElement($desktop.width - 400, 70, 380, 190, 1 | 2 | 4 | 8);
  with ($t = new_control($regsCurvePanel.$content)) {
    .setRect(10, 0, 330, 22);
    .text = $regsCurveStrings.$regs_curve_panel_title;
    .visible = true;
    .canActivate = false;
  }
  MAIN.$ui.setTitleFont($t);
  $regsCurveNames = [$regsCurveStrings.$regs_curve_mode_straight, $regsCurveStrings.$regs_curve_mode_curved,
                     $regsCurveStrings.$regs_curve_mode_freeform, $regsCurveStrings.$regs_curve_mode_remove];
  for ($regsI = 0; $regsI < 4; ++$regsI) {
    $regsB = MAIN.$ui.createChoiceButton($regsCurvePanel.$content, "regsCurveModes", 10 + $regsI * 88, 28, 84, 25, $regsCurveNames[$regsI], macro($regsI) :: regsCurveMode($0), "/metro/ui/button.dds", "/metro/ui/button.dds", "/metro/ui/button.dds");
    if ($regsI == regsCurveToolMode()) MAIN.$ui.selectChoiceButton($regsB, "regsCurveModes");
  }
  with ($regsCurveInfo = new_control($regsCurvePanel.$content)) {
    .setRect(10, 62, 340, 20);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .visible = true;
    .canActivate = false;
  }
  $regsHints = [$regsCurveStrings.$regs_curve_panel_hint1, $regsCurveStrings.$regs_curve_panel_hint2];
  for ($regsI = 0; $regsI < 2; ++$regsI) {
    with ($h = new_control($regsCurvePanel.$content)) {
      .setRect(10, 90 + 20 * $regsI, 340, 18);
      MAIN.$ui.setTextFont(current, 0xFFBBBBBB);
      .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
      .text = $regsHints[$regsI];
      .visible = true;
      .canActivate = false;
    }
  }
  thread :: {   // the panel follows the tool and goes with it (and when the roundabout panel takes over)
    while ($player.editMode == REGS_GRIDMODE_CURVE_ROAD && $regsCurveUi == "curve") {
      $ci = regsCurveToolInfo();
      $s = $regsCurveStrings;
      if (regsCurveToolMode() == 3) {
        $regsCurveInfo.text = $ci[4] ? $s.$regs_curve_info_remove : $s.$regs_curve_info_pick;
      } else if ($ci[0] == 0) {
        $regsCurveInfo.text = $s.$regs_curve_info_start;
      } else if (regsCurveToolMode() == 1 && $ci[0] == 1) {
        $regsCurveInfo.text = $s.$regs_curve_info_bend;
      } else {
        $regsCurveInfo.text = expandPattern($s.$regs_curve_info_length, int($ci[1] + 0.5), int($ci[2] + 0.5)) + ($ci[3] ? "" : "  " + $s.$regs_curve_info_bad);
      }
      wait 0.1;
    }
    delete $regsCurvePanel;
    $regsCurvePanel = null;
  };
}

// the tool for one road kind (0 small, 1 large, 2 avenue, 3 alley)
function regsCurveToolFor($k) {
  regsCurveToolKind($k);
  regsCurveTool();
}

function regsRoundLanesSet($n) {
  $regsRoundLanes = $n;
  regsCurveToolMode($n == 1 ? 4 : 5);
}

function regsRoundaboutTool() {
  $regsCurveUi = "round";
  regsCurveToolKind(0);
  $toolbar.selectTool(REGS_GRIDMODE_CURVE_ROAD);
  regsCurveToolMode($regsRoundLanes == 1 ? 4 : 5);
  if ($regsRoundPanel) return;
  $regsRoundStrings = regsStringsNow();
  $regsRoundPanel = MAIN.$ui.createHudElement($desktop.width - 400, 70, 380, 170, 1 | 2 | 4 | 8);
  with ($t = new_control($regsRoundPanel.$content)) {
    .setRect(10, 0, 330, 22);
    .text = $regsRoundStrings.$regs_round_title;
    .visible = true;
    .canActivate = false;
  }
  MAIN.$ui.setTitleFont($t);
  $regsRoundNames = [$regsRoundStrings.$regs_round_one, $regsRoundStrings.$regs_round_two];
  for ($regsI = 0; $regsI < 2; ++$regsI) {
    $regsB = MAIN.$ui.createChoiceButton($regsRoundPanel.$content, "regsRoundLanes", 10 + $regsI * 128, 28, 120, 25, $regsRoundNames[$regsI], macro($regsI + 1) :: regsRoundLanesSet($0), "/metro/ui/button.dds", "/metro/ui/button.dds", "/metro/ui/button.dds");
    if ($regsI + 1 == $regsRoundLanes) MAIN.$ui.selectChoiceButton($regsB, "regsRoundLanes");
  }
  with ($regsRoundInfo = new_control($regsRoundPanel.$content)) {
    .setRect(10, 62, 340, 20);
    MAIN.$ui.setTextFont(current);
    .textAlign = ALIGN_MIDDLE | ALIGN_LEFT;
    .visible = true;
    .canActivate = false;
  }
  with ($h = new_control($regsRoundPanel.$content)) {
    .setRect(10, 90, 340, 36);
    MAIN.$ui.setTextFont(current, 0xFFBBBBBB);
    .textAlign = ALIGN_TOP | ALIGN_LEFT;
    .text = $regsRoundStrings.$regs_round_hint1;
    .visible = true;
    .canActivate = false;
  }
  thread :: {
    while ($player.editMode == REGS_GRIDMODE_CURVE_ROAD && $regsCurveUi == "round") {
      $ci = regsCurveToolInfo();
      $regsRoundInfo.text = $ci[0] == 0 ? $regsRoundStrings.$regs_curve_info_centre : expandPattern($regsRoundStrings.$regs_curve_info_radius, int($ci[1] + 0.5), $regsRoundLanes) + ($ci[3] ? "" : "  " + $regsRoundStrings.$regs_curve_info_bad);
      wait 0.1;
    }
    delete $regsRoundPanel;
    $regsRoundPanel = null;
  };
}

// the buttons after the originals: Curve in the alley, small-road, large-road and avenue tabs, Roundabout in the
// small-road tab
$regsRs = regsStringsNow();
$regsCurveTabs = ["alley", "smallroad", "largeroad", "avenue"];
$regsCurveKinds = [3, 0, 1, 2];
// icons in the game's style (generated with Magnific from its road icons, fitted by tools/make-toolbar-icon.ps1)
$regsCurveIcons = ["curve-alley", "curve-small", "curve-large", "curve-avenue"];
for ($regsI = 0; $regsI < 4; ++$regsI) {
  $regsRoadTab = $trafficMenu.$tabs[$regsCurveTabs[$regsI]];
  $regsN = $regsRoadTab.getChildCount();
  $regsIcon = "/regs/ui/toolbar/" + $regsCurveIcons[$regsI];
  $regsB = MAIN.$ui.createChoiceButton($regsRoadTab, null, $regsN % 5 * 56, $regsN / 5 * 56, 46, 46, "", macro($regsCurveKinds[$regsI]) :: regsCurveToolFor($0), $regsIcon + ".dds", $regsIcon + "_se.dds", $regsIcon + "_ho.dds");
  $regsB.setCropRect(9.0 / 64.0, 9.0 / 64.0, 46.0 / 64.0, 46.0 / 64.0);
  MAIN.$ui.setTooltip($regsB, $regsRs.$regs_curve_hint, 0, 1);
}
$regsRoadTab = $trafficMenu.$tabs["smallroad"];
$regsN = $regsRoadTab.getChildCount();
$regsB = MAIN.$ui.createChoiceButton($regsRoadTab, null, $regsN % 5 * 56, $regsN / 5 * 56, 46, 46, "", regsRoundaboutTool, "/regs/ui/toolbar/roundabout.dds", "/regs/ui/toolbar/roundabout_se.dds", "/regs/ui/toolbar/roundabout_ho.dds");
$regsB.setCropRect(9.0 / 64.0, 9.0 / 64.0, 46.0 / 64.0, 46.0 / 64.0);
MAIN.$ui.setTooltip($regsB, $regsRs.$regs_round_tooltip, 0, 1);
delete $regsRs;
