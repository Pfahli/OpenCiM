// ReGS sky (sky.shader; the colours come from engine/sky.cpp addPortSky): a sky lit like a real one, in the cheap
// form a game can afford. The air brightens quickly toward the horizon (the light crosses more haze there), the sun
// has a forward-scattering glow (a Henyey-Greenstein lobe), a low sun warms the horizon on its side and the clouds'
// undersides, clouds drift on a plane overhead and are shaded from the sun's side (their density a little toward the
// sun darkens them, thin edges near the sun light up), and at night the stars and the moon come out. Under rain or
// snow the cover closes and everything turns grey. At the very bottom the sky takes the scene's fog colour, so the
// fogged town meets it without a seam; below the horizon nothing is drawn.
// custom0 = sun direction (world, towards the sun), sun strength   custom1 = zenith colour, cloud cover
// custom2 = horizon colour, stars                                   custom3 = fog colour, cloud brightness
// custom4 = moon direction, moon visibility                         custom5 = sunset tint, dusk
// custom6 = cloud drift (x, y), 0, 0
uniform vec4 custom0;
uniform vec4 custom1;
uniform vec4 custom2;
uniform vec4 custom3;
uniform vec4 custom4;
uniform vec4 custom5;
uniform vec4 custom6;
varying vec3 skyDir;

float skyHash(vec2 p) {
  return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453);
}

float skyNoise(vec2 p) {
  vec2 i = floor(p);
  vec2 f = fract(p);
  f = f * f * (3.0 - 2.0 * f);
  float a = mix(skyHash(i), skyHash(i + vec2(1.0, 0.0)), f.x);
  float b = mix(skyHash(i + vec2(0.0, 1.0)), skyHash(i + vec2(1.0, 1.0)), f.x);
  return mix(a, b, f.y);
}

float skyFbm(vec2 p) {
  float s = 0.0;
  float a = 0.5;
  for (int k = 0; k < 5; ++k) {
    s += a * skyNoise(p);
    p = p * 2.07 + vec2(1.7, 9.2);
    a *= 0.5;
  }
  return s;
}

// cloud density 0..1 at a point of the cloud plane, warped so the shapes billow rather than tile
float skyDensity(vec2 p, float cover) {
  vec2 w = vec2(skyFbm(p * 0.6 + vec2(4.1, 1.3)), skyFbm(p * 0.6 + vec2(8.3, 2.8)));
  float n = skyFbm(p + w * 1.4);
  return smoothstep(1.0 - cover - 0.08, 1.0 - cover + 0.32, n);
}

void main(void) {
  vec3 d = normalize(skyDir);
  if (d.y < -0.04) discard;
  float up = clamp(d.y, 0.0, 1.0);
  vec3 sun = normalize(custom0.xyz);
  float c = dot(d, sun);
  float cover = custom1.w;
  // the air: the zenith colour overhead, the paler horizon colour in a band that thickens toward the horizon,
  // the sunset tint along the horizon on the sun's side
  vec2 flatD = normalize(d.xz + vec2(0.0001));
  vec2 flatS = normalize(sun.xz + vec2(0.0001));
  float toward = pow(max(dot(flatD, flatS), 0.0), 2.5);
  vec3 horizon = mix(custom2.rgb, custom5.rgb, custom5.w * mix(0.25, 1.0, toward));
  vec3 col = mix(custom1.rgb, horizon, exp(-up * 4.5));
  // the sun's glow: Henyey-Greenstein, g = 0.78, plus a tight core around the game's sun disc
  float g = 0.78;
  float hg = (1.0 - g * g) / pow(1.0 + g * g - 2.0 * g * c, 1.5);
  vec3 sunLight = mix(vec3(1.0, 0.93, 0.80), vec3(1.0, 0.62, 0.32), custom5.w);
  col += sunLight * custom0.w * (hg * 0.018 + pow(max(c, 0.0), 300.0) * 0.6);
  // stars: fixed points on the dome, fainter toward the horizon
  if (custom2.w > 0.0 && d.y > 0.0) {
    vec2 p = d.xz / (1.0 + d.y) * 280.0;
    vec2 cell = floor(p);
    float h = skyHash(cell);
    if (h > 0.986) {
      vec2 at = cell + 0.25 + 0.5 * vec2(skyHash(cell + 7.1), skyHash(cell + 3.3));
      float s = smoothstep(0.45, 0.0, length(p - at)) * (0.35 + 0.65 * (h - 0.986) / 0.014);
      col += vec3(0.82, 0.88, 1.0) * s * custom2.w * smoothstep(0.03, 0.3, d.y);
    }
  }
  // the moon: a pale disc with faint maria and a soft halo
  if (custom4.w > 0.0) {
    vec3 moon = normalize(custom4.xyz);
    float m = dot(d, moon);
    col += vec3(0.50, 0.56, 0.68) * (pow(max(m, 0.0), 400.0) * 0.18 + pow(max(m, 0.0), 40.0) * 0.03) * custom4.w;
    float disc = smoothstep(0.99960, 0.99972, m);
    vec3 surface = vec3(0.90, 0.90, 0.86) * (0.78 + 0.22 * skyFbm(d.xz * 2600.0));
    col = mix(col, surface, disc * custom4.w);
  }
  // clouds on a plane overhead, drifting, shaded from the sun's side
  if (d.y > 0.0 && cover > 0.0) {
    vec2 uv = d.xz / (d.y + 0.12) * 1.1 + custom6.xy;
    float dens = skyDensity(uv, cover);
    if (dens > 0.0) {
      float ahead = skyDensity(uv + flatS * 0.18, cover);
      float lit = exp(-2.2 * ahead);
      vec3 bright = vec3(custom3.w) * mix(vec3(1.0), sunLight, 0.35 + 0.65 * custom5.w);
      vec3 shade = mix(vec3(custom3.w * 0.58), custom1.rgb * 0.9, 0.25);
      vec3 cloud = mix(shade, bright, lit * custom0.w + (1.0 - custom0.w) * 0.55);
      cloud += sunLight * custom0.w * pow(max(c, 0.0), 10.0) * (1.0 - dens) * 0.6;  // thin edges near the sun
      float a = dens * smoothstep(0.0, 0.18, d.y) * 0.92;
      col = mix(col, cloud, a);
    }
  }
  // the bottom band: the scene's fog colour, so the fogged ground meets the sky
  col = mix(custom3.rgb, col, smoothstep(-0.01, 0.09, d.y));
  // a little dither against the 8-bit bands of a smooth gradient
  col += (skyHash(gl_FragCoord.xy) - 0.5) / 255.0;
  gl_FragColor = vec4(col, 1.0);
}
