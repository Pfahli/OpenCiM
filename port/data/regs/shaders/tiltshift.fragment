// ReGS tilt-shift lens blur (setting regsLensBlur): one direction of a separable 9-tap Gaussian whose radius grows
// with the distance from a sharp horizontal band around the camera target (the screen centre), giving the
// "miniature city" look.
// custom0 = (texel step x, texel step y, max radius in texels, 0), custom1 = (focus centre y, band half height, ramp, 0)
uniform sampler2D texture0;
uniform vec4 custom0;
uniform vec4 custom1;
varying vec4 texCoord;

void main(void) {
  float t = smoothstep(custom1.y, custom1.y + custom1.z, abs(texCoord.y - custom1.x));
  vec2 o = custom0.xy * (custom0.z * t * 0.25);
  vec2 uv = texCoord.xy;
  vec4 c = texture2D(texture0, uv) * 0.2270270270;
  c += (texture2D(texture0, uv + o) + texture2D(texture0, uv - o)) * 0.1945945946;
  c += (texture2D(texture0, uv + o * 2.0) + texture2D(texture0, uv - o * 2.0)) * 0.1216216216;
  c += (texture2D(texture0, uv + o * 3.0) + texture2D(texture0, uv - o * 3.0)) * 0.0540540541;
  c += (texture2D(texture0, uv + o * 4.0) + texture2D(texture0, uv - o * 4.0)) * 0.0162162162;
  gl_FragColor = c;
}
